---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Cart from '../../components/Cart.astro';
import Footer from '../../components/Footer.astro';
import ShopExplorer from '../../components/ShopExplorer.vue';

const sectorInicial = Astro.url.searchParams.get('sector') || '';
---

<BaseLayout title="Tienda - DOMUS | Todo para sentir tu hogar" description="Explorá todo el catálogo DOMUS: aromas, comida, ropa y experiencias. Filtrá por categoría y precio, descubrí los más vendidos y aprovechá las ofertas.">
  <Navbar />
  <Cart />

  <main class="tienda-page">
    <!-- Hero / Banner -->
    <section class="tienda-hero">
      <div class="container">
        <p class="tienda-eyebrow">Tienda DOMUS</p>
        <h1>Todo para sentir tu hogar</h1>
        <p class="tienda-tagline">Aromas, comida, ropa y experiencias en un solo lugar.</p>
      </div>
    </section>

    <!-- Más vendidos (se completa por JS; se oculta si no hay datos) -->
    <section id="mas-vendidos" class="tienda-section tienda-bests" hidden>
      <div class="container">
        <div class="tienda-section-head tienda-head-row">
          <div>
            <h2>Los más vendidos</h2>
            <p>Los favoritos de la comunidad DOMUS.</p>
          </div>
          <div class="tienda-nav">
            <button type="button" class="t-nav" data-carousel="bests-grid" data-dir="-1" aria-label="Anterior">‹</button>
            <button type="button" class="t-nav" data-carousel="bests-grid" data-dir="1" aria-label="Siguiente">›</button>
          </div>
        </div>
        <div id="bests-grid" class="tienda-strip"></div>
      </div>
    </section>

    <!-- Ofertas (se completa por JS; se oculta si no hay datos) -->
    <section id="ofertas" class="tienda-section tienda-offers" hidden>
      <div class="container">
        <div class="tienda-section-head tienda-head-row">
          <div>
            <h2>Ofertas de la semana</h2>
            <p>Descuentos reales, stock limitado.</p>
          </div>
          <div class="tienda-nav">
            <button type="button" class="t-nav" data-carousel="offers-grid" data-dir="-1" aria-label="Anterior">‹</button>
            <button type="button" class="t-nav" data-carousel="offers-grid" data-dir="1" aria-label="Siguiente">›</button>
          </div>
        </div>
        <div id="offers-grid" class="tienda-strip"></div>
      </div>
    </section>

    <!-- Explorador con filtros -->
    <section class="tienda-section">
      <div class="container">
        <div class="tienda-section-head">
          <h2>Explorar catálogo</h2>
          <p>Buscá, filtrá y compará todo el catálogo.</p>
        </div>
        <ShopExplorer client:visible sectorInicial={sectorInicial} />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const IMG = {
    aromas: 'https://images.unsplash.com/photo-1602928321679-560bb453f190?w=400&h=400&fit=crop',
    comida: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=400&h=400&fit=crop',
    ropa: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=400&h=400&fit=crop',
    experiencias: 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&h=400&fit=crop',
  };
  const FALLBACKS = {
    'Sahumerios': IMG.aromas, 'Difusores': IMG.aromas, 'Velas': IMG.aromas, 'Aromas': IMG.aromas,
    'Comida': IMG.comida, 'Ropa': IMG.ropa, 'Experiencias': IMG.experiencias,
  };
  const fallbackImg = IMG.aromas;

  function fotoDe(p) {
    if (p.imagen_url) return p.imagen_url;
    return FALLBACKS[(p.categoria || '').trim()] || fallbackImg;
  }

  // Lucide shopping-cart-plus
  const SVG_CARRITO = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 5h6"/><path d="M19 2v6"/><path d="m2.05 2.05 1.099-.028a1 1 0 011.008.815l2.69 14.347A1 1 0 007.83 18H18"/><path d="M4.564 5H12"/><path d="M6.25 14h12.712a2 2 0 001.991-1.57l.172-1.041"/><circle cx="18" cy="20" r="2"/><circle cx="8" cy="20" r="2"/></svg>';
  const SVG_TILDE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

  function cardHTML(p) {
    const precioFinal = Number(p.precio_final ?? p.precio_venta);
    const precioVenta = Number(p.precio_venta);
    const nombre = (p.nombre || '').replace(/</g, '&lt;');
    const variante = p.variante && p.variante !== 'Única' ? String(p.variante) : '';
    const visible = variante ? `${nombre} — ${variante}` : nombre;
    const href = `/tienda/producto/${encodeURIComponent(String(p.sku || '').trim())}`;
    const img = fotoDe(p);
    const sinStock = (p.stock_actual ?? 0) <= 0;

    const badges =
      (sinStock
        ? '<span class="t-badge t-badge-out">SIN STOCK</span>'
        : p.vendidos_90d > 0
          ? '<span class="t-badge t-badge-sold">MÁS VENDIDO</span>'
          : '') +
      (p.descuento_pct > 0 ? `<span class="t-badge t-badge-off">-${p.descuento_pct}%</span>` : '');

    const precio = p.descuento_pct > 0
      ? `<span class="t-price-old">$${precioVenta.toLocaleString('es-AR')}</span>
         <span class="t-price">$${precioFinal.toLocaleString('es-AR')}</span>`
      : `<span class="t-price">$${precioFinal.toLocaleString('es-AR')}</span>`;

    const item = JSON.stringify({
      id: p.producto_id,
      name: visible,
      price: precioFinal,
      image: img,
      stock: Number(p.stock_actual ?? 0),
    }).replace(/&/g, '&amp;').replace(/"/g, '&quot;');

    return `
      <article class="t-card" data-id="${p.producto_id}">
        <div class="t-media">
          <a class="t-media-link" href="${href}" aria-label="Ver ${visible}">
            <img src="${img}" alt="${visible}" loading="lazy" onerror="this.src='${fallbackImg}'" />
          </a>
          <button class="t-add-icon" type="button" data-item="${item}"
            data-label-alta="Agregar ${visible} al carrito"
            data-label-carrito="Ya en el carrito: ${visible}"
            ${sinStock ? 'disabled' : ''}
            aria-label="${sinStock ? `${visible}: sin stock` : `Agregar ${visible} al carrito`}">
            ${sinStock ? '' : SVG_CARRITO}
          </button>
          ${badges}
        </div>
        <div class="t-body">
          <p class="t-cat">${p.categoria || 'General'}</p>
          <h3><a class="t-title" href="${href}">${visible}</a></h3>
          ${precio}
        </div>
      </article>`;
  }

  // Agregar rápido desde la tarjeta: animación + tilde de confirmación
  type CarritoGlobal = {
    getCount?: () => number;
    addItem?: (item: { id: string; name: string; price: number; image?: string; stock?: number; quantity?: number }) => void;
  };

  function idsEnCarrito(): Set<string> {
    const ids = new Set<string>();
    try {
      const cart = JSON.parse(localStorage.getItem('domus_cart') || '[]');
      if (Array.isArray(cart)) {
        for (const item of cart) if (item?.id) ids.add(String(item.id));
      }
    } catch { /* noop */ }
    return ids;
  }

  // Estado persistente "ya está en el carrito": borde + tilde oliva
  function pintarEstadoCarrito() {
    const ids = idsEnCarrito();
    document.querySelectorAll<HTMLElement>('.t-card[data-id]').forEach((card) => {
      const en = ids.has(card.dataset.id || '');
      card.classList.toggle('is-in-cart', en);
      const btn = card.querySelector<HTMLButtonElement>('.t-add-icon');
      if (!btn) return;
      btn.classList.toggle('is-in-cart', en);
      if (btn.classList.contains('is-added')) return;
      if (btn.disabled && !en) {
        btn.innerHTML = '';
        return;
      }
      btn.innerHTML = en ? SVG_TILDE : SVG_CARRITO;
      btn.setAttribute(
        'aria-label',
        en ? (btn.dataset.labelCarrito || 'Ya en el carrito') : (btn.dataset.labelAlta || 'Agregar al carrito')
      );
    });
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.t-add-icon') as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;
    e.stopPropagation();
    const carrito = (window as unknown as { CartManager?: CarritoGlobal }).CartManager;
    if (!carrito) return;
    let item: { id: string; name: string; price: number; image?: string; stock?: number };
    try { item = JSON.parse(btn.dataset.item || ''); } catch { return; }
    const antes = carrito.getCount?.() ?? 0;
    carrito.addItem?.(item);
    if ((carrito.getCount?.() ?? antes) <= antes) return;
    btn.classList.add('is-added');
    btn.innerHTML = SVG_TILDE;
    btn.setAttribute('aria-label', btn.dataset.labelCarrito || 'Ya en el carrito');
    btn.closest('.t-card')?.classList.add('is-added');
    window.setTimeout(() => {
      btn.classList.remove('is-added');
      btn.closest('.t-card')?.classList.remove('is-added');
      pintarEstadoCarrito();
    }, 1600);
  });

  // Toda la tarjeta lleva a la página del producto (estilo MercadoLibre)
  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    if (el.closest('a') || el.closest('button')) return;
    const card = el.closest('.t-card');
    const href = card?.querySelector('.t-title')?.getAttribute('href');
    if (href) window.location.href = href;
  });

  async function cargarTira(url, gridId, sectionId) {
    try {
      const res = await fetch(url);
      if (!res.ok) return;
      const items = await res.json();
      if (!items.length) return;
      const grid = document.getElementById(gridId);
      const section = document.getElementById(sectionId);
      if (!grid || !section) return;
      grid.innerHTML = items.map(cardHTML).join('');
      section.hidden = false;
      pintarEstadoCarrito();
    } catch {
      // Sin datos (Supabase sin configurar o sin ventas): la sección queda oculta
    }
  }

  cargarTira('/api/tienda/mas-vendidos?limit=8', 'bests-grid', 'mas-vendidos');
  cargarTira('/api/tienda/ofertas?limit=8', 'offers-grid', 'ofertas');

  // Mantener el estado del carrito sincronizado (alta/baja desde cualquier lado)
  window.addEventListener('domus:cart-updated', pintarEstadoCarrito);
  window.addEventListener('domus:cart-cleared', pintarEstadoCarrito);
  window.addEventListener('storage', pintarEstadoCarrito);
  pintarEstadoCarrito();

  // Flechas del carrusel
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.t-nav') as HTMLElement | null;
    if (!btn) return;
    const grid = document.getElementById(btn.dataset.carousel || '');
    if (!grid) return;
    const paso = grid.clientWidth * 0.8;
    grid.scrollBy({ left: Number(btn.dataset.dir) * paso, behavior: 'smooth' });
  });
</script>

<style is:global>
  .tienda-page {
    padding-top: 80px;
  }

  /* Contenedor más contenido: grilla densa tipo marketplace */
  .tienda-page .container {
    max-width: 1280px;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .tienda-hero {
    background: var(--color-hueso);
    border-bottom: 1px solid rgba(96, 72, 17, 0.22);
    color: var(--color-tierra);
    padding: 2.25rem 0;
  }

  .tienda-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.75rem;
    font-weight: 400;
    font-family: 'Montserrat', sans-serif;
    color: var(--color-oliva-dark);
    margin: 0 0 0.75rem;
  }

  .tienda-hero h1 {
    margin: 0 0 0.5rem;
    font-family: 'Bricolage Grotesque', serif;
    font-weight: 400;
    color: var(--color-tierra);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .tienda-tagline {
    margin: 0;
    font-family: 'Bricolage Grotesque', serif;
    font-size: 1.125rem;
    color: rgba(96, 72, 17, 0.8);
  }

  .tienda-section {
    padding: 2.5rem 0;
  }

  .tienda-section:nth-of-type(3) {
    background: var(--color-beige-light);
  }

  .tienda-bests {
    background: white;
  }

  .tienda-offers {
    background: var(--color-hueso-soft);
  }

  .tienda-section-head {
    margin-bottom: 1.25rem;
  }

  .tienda-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .tienda-nav {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .t-nav {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(96, 72, 17, 0.25);
    background: #fff;
    color: var(--color-tierra);
    font-size: 1.375rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .t-nav:hover {
    background: var(--color-oliva);
    border-color: var(--color-oliva);
    color: var(--color-hueso);
  }

  .tienda-section-head h2 {
    margin: 0 0 0.25rem;
    color: var(--color-brown);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
  }

  .tienda-section-head p {
    margin: 0;
    color: var(--color-brown-light);
    font-size: 1rem;
  }

  /* Carrusel horizontal (estilo marketplace) */
  .tienda-strip {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    padding-bottom: 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(96, 72, 17, 0.3) transparent;
  }

  .tienda-strip::-webkit-scrollbar {
    height: 6px;
  }

  .tienda-strip::-webkit-scrollbar-thumb {
    background: rgba(96, 72, 17, 0.25);
    border-radius: 999px;
  }

  .t-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(61, 43, 31, 0.08);
    display: flex;
    flex-direction: column;
    height: 100%;
    cursor: pointer;
  }

  /* Tarjetas compactas del carrusel */
  .tienda-strip .t-card {
    flex: 0 0 196px;
    scroll-snap-align: start;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .tienda-strip .t-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(61, 43, 31, 0.14);
  }

  .tienda-strip .t-media {
    aspect-ratio: 1 / 1;
  }

  .tienda-strip .t-body {
    padding: 0.75rem 0.875rem 1rem;
    gap: 0.25rem;
  }

  .tienda-strip .t-cat {
    font-size: 0.6875rem;
  }

  .tienda-strip .t-body h3 {
    font-size: 0.9375rem;
    min-height: calc(1.3em * 2);
  }

  .tienda-strip .t-price {
    font-size: 1.125rem;
  }

  .tienda-strip .t-price-old {
    font-size: 0.8125rem;
  }

  .t-media {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--color-beige);
  }

  .t-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .t-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .t-card:hover .t-media img {
    transform: scale(1.04);
  }

  /* Agregar rápido desde la tarjeta (estilo MercadoLibre) */
  .t-add-icon {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 2;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(61, 43, 31, 0.16);
    background: white;
    color: var(--color-olive);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 14px rgba(61, 43, 31, 0.22);
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .t-add-icon svg {
    width: 19px;
    height: 19px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .t-add-icon:hover:not(:disabled) {
    background: var(--color-olive);
    color: white;
    transform: scale(1.08);
    box-shadow: 0 8px 18px rgba(152, 140, 45, 0.35);
  }

  .t-add-icon:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    box-shadow: none;
  }

  .t-add-icon.is-added {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: white;
    animation: domus-pop-t 0.35s ease;
  }

  .t-card.is-added {
    box-shadow: 0 0 0 2px var(--color-olive), 0 10px 24px rgba(61, 43, 31, 0.14);
  }

  /* Ya está en el carrito: borde oliva persistente */
  .t-card.is-in-cart {
    box-shadow: 0 0 0 2px var(--color-olive), 0 8px 20px rgba(152, 140, 45, 0.18);
  }

  .t-card.is-in-cart .t-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(152, 140, 45, 0.08);
    pointer-events: none;
  }

  .t-add-icon.is-in-cart {
    background: var(--color-olive);
    color: white;
    border-color: var(--color-olive);
    box-shadow: 0 6px 16px rgba(152, 140, 45, 0.4);
  }

  .t-add-icon.is-in-cart:hover:not(:disabled) {
    filter: brightness(1.06);
  }

  @keyframes domus-pop-t {
    0% { transform: scale(1); }
    45% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-add-icon.is-added,
    .t-media img {
      animation: none;
      transition: none;
    }
  }

  .t-badge {
    position: absolute;
    top: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    color: white;
  }

  .t-badge-sold {
    left: 0.625rem;
    background: var(--color-olive);
  }

  .t-badge-off {
    right: 0.625rem;
    background: #e53e3e;
  }

  .t-badge-out {
    left: 0.625rem;
    background: var(--color-brown);
  }

  .t-body {
    padding: 1rem 1.125rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .t-cat {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-olive);
    font-weight: 600;
  }

  .t-body h3 {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-brown);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.3em * 2);
  }

  .t-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brown);
  }

  .t-price-old {
    font-size: 0.9375rem;
    color: var(--color-brown-light);
    text-decoration: line-through;
    margin-right: 0.5rem;
  }

  .t-title {
    color: inherit;
    text-decoration: none;
  }

  .t-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .t-title:focus-visible,
  .t-media-link:focus-visible {
    outline: 2px solid var(--color-olive);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .t-add-icon:focus-visible {
    outline: 2px solid var(--color-olive);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .tienda-hero {
      padding: 1.75rem 0;
    }

    .tienda-section {
      padding: 2rem 0;
    }

    .tienda-strip .t-card {
      flex: 0 0 158px;
    }

    .tienda-nav {
      display: none;
    }

    .tienda-tagline {
      font-size: 1.0625rem;
    }
  }
</style>
