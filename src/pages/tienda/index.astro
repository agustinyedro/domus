---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Cart from '../../components/Cart.astro';
import Footer from '../../components/Footer.astro';
import ShopExplorer from '../../components/ShopExplorer.vue';

const sectorInicial = Astro.url.searchParams.get('sector') || '';
---

<BaseLayout title="Tienda - DOMUS | Todo para sentir tu hogar" description="Explorá todo el catálogo DOMUS: aromas, comida, ropa y experiencias. Filtrá por categoría y precio, descubrí los más vendidos y aprovechá las ofertas.">
  <Navbar />
  <Cart />

  <main class="tienda-page">
    <!-- Hero / Banner -->
    <section class="tienda-hero">
      <div class="container">
        <p class="tienda-eyebrow">Tienda DOMUS</p>
        <h1>Todo para sentir tu hogar</h1>
        <p class="tienda-tagline">Aromas, comida, ropa y experiencias en un solo lugar.</p>
      </div>
    </section>

    <!-- Más vendidos (se completa por JS; se oculta si no hay datos) -->
    <section id="mas-vendidos" class="tienda-section tienda-bests" hidden>
      <div class="container">
        <div class="tienda-section-head">
          <h2>Los más vendidos</h2>
          <p>Los favoritos de la comunidad DOMUS.</p>
        </div>
        <div id="bests-grid" class="tienda-strip"></div>
      </div>
    </section>

    <!-- Ofertas (se completa por JS; se oculta si no hay datos) -->
    <section id="ofertas" class="tienda-section tienda-offers" hidden>
      <div class="container">
        <div class="tienda-section-head">
          <h2>Ofertas de la semana</h2>
          <p>Descuentos reales, stock limitado.</p>
        </div>
        <div id="offers-grid" class="tienda-strip"></div>
      </div>
    </section>

    <!-- Explorador con filtros -->
    <section class="tienda-section">
      <div class="container">
        <div class="tienda-section-head">
          <h2>Explorar catálogo</h2>
          <p>Buscá, filtrá y compará todo el catálogo.</p>
        </div>
        <ShopExplorer client:visible sectorInicial={sectorInicial} />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const IMG = {
    aromas: 'https://images.unsplash.com/photo-1602928321679-560bb453f190?w=400&h=400&fit=crop',
    comida: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=400&h=400&fit=crop',
    ropa: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=400&h=400&fit=crop',
    experiencias: 'https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&h=400&fit=crop',
  };
  const FALLBACKS = {
    'Sahumerios': IMG.aromas, 'Difusores': IMG.aromas, 'Velas': IMG.aromas, 'Aromas': IMG.aromas,
    'Comida': IMG.comida, 'Ropa': IMG.ropa, 'Experiencias': IMG.experiencias,
  };
  const fallbackImg = IMG.aromas;

  function fotoDe(p) {
    if (p.imagen_url) return p.imagen_url;
    return FALLBACKS[(p.categoria || '').trim()] || fallbackImg;
  }

  function cardHTML(p) {
    const precioFinal = Number(p.precio_final ?? p.precio_venta);
    const precioVenta = Number(p.precio_venta);
    const nombre = (p.nombre || '').replace(/</g, '&lt;');
    const img = fotoDe(p);
    const sinStock = (p.stock_actual ?? 0) <= 0;

    const badges =
      (p.vendidos_90d > 0 ? '<span class="t-badge t-badge-sold">MÁS VENDIDO</span>' : '') +
      (p.descuento_pct > 0 ? `<span class="t-badge t-badge-off">-${p.descuento_pct}%</span>` : '');

    const precio = p.descuento_pct > 0
      ? `<span class="t-price-old">$${precioVenta.toLocaleString('es-AR')}</span>
         <span class="t-price">$${precioFinal.toLocaleString('es-AR')}</span>`
      : `<span class="t-price">$${precioFinal.toLocaleString('es-AR')}</span>`;

    return `
      <article class="t-card">
        <div class="t-media">
          <img src="${img}" alt="${nombre}" loading="lazy" onerror="this.src='${fallbackImg}'" />
          ${badges}
        </div>
        <div class="t-body">
          <p class="t-cat">${p.categoria || 'General'}</p>
          <h3>${nombre}</h3>
          ${precio}
          <button class="btn t-add" ${sinStock ? 'disabled' : ''}
            onclick="CartManager.addItem({id: '${p.producto_id}', name: '${nombre.replace(/'/g, "\\'")}', price: ${precioFinal}, image: '${img}'})">
            ${sinStock ? 'Sin stock' : 'Agregar'}
          </button>
        </div>
      </article>`;
  }

  async function cargarTira(url, gridId, sectionId) {
    try {
      const res = await fetch(url);
      if (!res.ok) return;
      const items = await res.json();
      if (!items.length) return;
      const grid = document.getElementById(gridId);
      const section = document.getElementById(sectionId);
      if (!grid || !section) return;
      grid.innerHTML = items.map(cardHTML).join('');
      section.hidden = false;
    } catch {
      // Sin datos (Supabase sin configurar o sin ventas): la sección queda oculta
    }
  }

  cargarTira('/api/tienda/mas-vendidos?limit=4', 'bests-grid', 'mas-vendidos');
  cargarTira('/api/tienda/ofertas?limit=4', 'offers-grid', 'ofertas');
</script>

<style>
  .tienda-page {
    padding-top: 80px;
  }

  /* La tienda usa casi todo el ancho (landing: 1200px + 2rem de padding) */
  .tienda-page .container {
    max-width: 1520px;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .tienda-hero {
    background: linear-gradient(135deg,
      var(--color-brown) 0%,
      var(--color-brown-light) 55%,
      var(--color-olive) 130%);
    color: white;
    padding: 3.5rem 0;
  }

  .tienda-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-olive-light);
    margin: 0 0 0.75rem;
  }

  .tienda-hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .tienda-tagline {
    margin: 0;
    font-size: 1.2rem;
    opacity: 0.9;
  }

  .tienda-section {
    padding: 3.5rem 0;
  }

  .tienda-section:nth-of-type(3) {
    background: var(--color-beige-light);
  }

  .tienda-bests {
    background: white;
  }

  .tienda-offers {
    background: linear-gradient(180deg, #fff8f0 0%, #ffffff 100%);
  }

  .tienda-section-head {
    margin-bottom: 1.5rem;
  }

  .tienda-section-head h2 {
    margin: 0 0 0.25rem;
    color: var(--color-brown);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .tienda-section-head p {
    margin: 0;
    color: var(--color-brown-light);
    font-size: 1.0625rem;
  }

  .tienda-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .t-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(61, 43, 31, 0.08);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .t-media {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--color-beige);
  }

  .t-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .t-badge {
    position: absolute;
    top: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    color: white;
  }

  .t-badge-sold {
    left: 0.625rem;
    background: var(--color-olive);
  }

  .t-badge-off {
    right: 0.625rem;
    background: #e53e3e;
  }

  .t-body {
    padding: 1rem 1.125rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .t-cat {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-olive);
    font-weight: 600;
  }

  .t-body h3 {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-brown);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.3em * 2);
  }

  .t-price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brown);
  }

  .t-price-old {
    font-size: 0.9375rem;
    color: var(--color-brown-light);
    text-decoration: line-through;
    margin-right: 0.5rem;
  }

  .t-add {
    margin-top: auto;
    width: 100%;
  }

  .t-add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .tienda-hero {
      padding: 2.5rem 0;
    }

    .tienda-section {
      padding: 2.25rem 0;
    }

    .tienda-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .tienda-tagline {
      font-size: 1.0625rem;
    }
  }
</style>
