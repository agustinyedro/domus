---
// src/pages/admin/compras/index.astro
// Registrar compras multi-producto + historial
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import ProductoModal from '@/components/admin/ProductoModal.vue';
---

<AdminLayout title="Compras">
  <h1 style="margin: 0 0 1.5rem; font-size: 1.5rem;">Compras</h1>

  <div class="admin-card" style="margin-bottom: 1rem;">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Registrar compra</h2>
    <div class="compra-import">
      <div>
        <h3>Importar desde Excel o CSV</h3>
        <p>Elegí un archivo y completamos los productos, cantidades y costos. Revisá el total y registrá la compra con un clic.</p>
      </div>
      <div class="compra-import-actions">
        <label class="admin-form-label" for="c-file">Archivo de compra (.xlsx o .csv)</label>
        <input id="c-file" type="file" class="admin-input" accept=".xlsx,.csv" aria-describedby="c-import-help" />
        <button type="button" id="c-template" class="admin-btn admin-btn-ghost">Descargar plantilla CSV</button>
      </div>
      <p id="c-import-help">Columnas: <strong>SKU (o Producto + Variante), Cantidad y Costo unitario</strong>. Hasta 50 filas y 5 MB. Si un producto tiene variantes, agregá la columna <strong>Variante</strong> (o Sabor/Aroma/Tamaño) para que cada fila caiga en la opción correcta. Usá el SKU del catálogo; para conservar ceros iniciales, guardalo como texto en Excel. No crea productos nuevos.</p>
      <div id="c-sheet-box" hidden>
        <label class="admin-form-label" for="c-sheet">El archivo tiene varias hojas. Elegí la que querés cargar.</label>
        <select id="c-sheet" class="admin-input"><option value="">Elegí una hoja</option></select>
      </div>
      <p id="c-import-status" role="status" aria-live="polite"></p>
      <div id="c-import-error" class="admin-alert admin-alert-error" role="alert" hidden></div>
    </div>
    <form id="compra-form" class="admin-form" style="max-width: none;">
      <div id="c-rows" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>

      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem;">
        <button type="button" id="c-add-row" class="admin-btn admin-btn-primary">
          + Agregar producto
        </button>
        <button type="button" id="c-new-prod-btn" class="admin-btn admin-btn-ghost">
          + Crear producto nuevo
        </button>
      </div>

      <div class="admin-form-group" style="margin-top: 1rem; max-width: 480px;">
        <label class="admin-form-label" for="c-obs">Observaciones (para toda la compra)</label>
        <input id="c-obs" type="text" class="admin-input" maxlength="500" placeholder="Ej: proveedor X" />
      </div>

      <p style="margin: 1rem 0 0; font-size: 1rem;">Costo total: <strong id="c-total">$0</strong></p>
      <div id="c-error" class="admin-alert admin-alert-error" style="display:none; margin-top: 1rem;"></div>
      <div id="c-ok" class="admin-alert admin-alert-success" style="display:none; margin-top: 1rem;"></div>
      <button type="submit" id="c-btn" class="admin-btn admin-btn-success" style="margin-top: 1rem;">Registrar compra</button>
    </form>
    <p style="margin: 1rem 0 0; font-size: 0.8125rem; color: var(--admin-text-muted);">
      Cada producto suma stock y actualiza su costo al último costo de compra.
    </p>
  </div>

  <ProductoModal client:load />

  <div class="admin-card">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Historial</h2>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr><th>Fecha</th><th>Producto</th><th class="text-right">Cant.</th><th class="text-right">Costo u.</th><th class="text-right">Total</th><th>Obs.</th></tr>
        </thead>
        <tbody id="c-historial">
          <tr><td colspan="6" class="text-center">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { readCompraFile, prepareCompraImport, MAX_COMPRA_ROWS } from '@/lib/compra-import';

    interface ProductoNuevo {
      id: string;
      nombre: string;
      costo?: number;
      grupo_id?: string | null;
      variante?: string;
    }


    const rowsBox = document.getElementById('c-rows')!;
    const errDiv = document.getElementById('c-error')!;
    const okDiv = document.getElementById('c-ok')!;
    const btn = document.getElementById('c-btn') as HTMLButtonElement;
    const fmt$ = (n: number) => n.toLocaleString('es-AR', { style: 'currency', currency: 'ARS', minimumFractionDigits: 2 });
    const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
    const normalizarBusqueda = (value: unknown) => String(value ?? '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
    let productos: Array<any> = [];

    function productoConVariante(p: any): string {
      const variante = String(p?.variante ?? '').trim();
      const base = String(p?.nombre ?? '');
      return variante && !/^ú?nica$/i.test(variante) ? `${base} · ${variante}` : base;
    }

    function etiquetaOpcion(p: any, enGrupo = false): string {
      const variante = String(p.variante ?? '').trim();
      const nombre = String(p.nombre ?? '');
      const base = enGrupo
        ? (variante || nombre)
        : (variante && !/^ú?nica$/i.test(variante) ? `${nombre} · ${variante}` : nombre);
      return `${escapeHtml(base)} · ${escapeHtml(p.sku || '')}`;
    }

    function opcionesProductos(selValue = '', filtro = ''): string {
      const query = normalizarBusqueda(filtro);
      const filtrados = productos.filter((p: any) => {
        const id = p.producto_id || p.id;
        return id === selValue || !query || normalizarBusqueda(`${p.nombre} ${p.variante || ''} ${p.nombre_opcion || ''} ${p.sku || ''}`).includes(query);
      });
      const grupos = new Map<string, Array<any>>();
      for (const p of filtrados) {
        const key = String(p.grupo_id || p.nombre || p.id);
        if (!grupos.has(key)) grupos.set(key, []);
        grupos.get(key)!.push(p);
      }
      const orden = new Intl.Collator('es');
      const optsDe = (items: Array<any>, enGrupo: boolean) => items
        .slice()
        .sort((a, b) => orden.compare(String(a.variante || ''), String(b.variante || '')))
        .map(p => {
          const id = p.producto_id || p.id;
          return `<option value="${escapeHtml(id)}" data-costo="${escapeHtml(p.costo)}" ${id === selValue ? 'selected' : ''}>${etiquetaOpcion(p, enGrupo)}</option>`;
        })
        .join('');
      const vacio = query && filtrados.length === 0 ? '<option value="">Sin coincidencias</option>' : '<option value="">— Elegí —</option>';
      return vacio + [...grupos.values()]
        .map(items => items.length > 1
          ? `<optgroup label="${escapeHtml(String(items[0]?.nombre || ''))}">${optsDe(items, true)}</optgroup>`
          : optsDe(items, false))
        .join('');
    }

    function agregarFila(selValue = '', cantidad = 1, costo?: number) {
      const row = document.createElement('div');
      row.className = 'c-row';
      row.style.cssText = 'display: grid; grid-template-columns: 2fr 1fr 1fr auto auto; gap: 0.5rem; align-items: end;';
      row.innerHTML = `
        <div class="admin-form-group">
          <label class="admin-form-label">Producto</label>
          <input type="search" class="admin-input product-search c-prod-search" placeholder="Buscar por nombre, opción o SKU…" aria-label="Buscar producto" autocomplete="off" />
          <select class="admin-input c-prod" required>${opcionesProductos(selValue)}</select>
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">Cantidad</label>
          <input type="number" class="admin-input c-cant" min="1" step="1" value="1" required />
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">Costo u. ($)</label>
          <input type="number" class="admin-input c-costo" min="0" step="0.01" required />
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">&nbsp;</label>
          <p class="c-sub" style="margin: 0; padding: 0.625rem 0; font-size: 0.875rem; font-weight: 600; white-space: nowrap;">$0</p>
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">&nbsp;</label>
          <button type="button" class="row-del c-del" aria-label="Quitar fila" title="Quitar fila">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>`;
      rowsBox.appendChild(row);
      (row.querySelector('.c-cant') as HTMLInputElement).value = String(cantidad);
      if (costo !== undefined) (row.querySelector('.c-costo') as HTMLInputElement).value = String(costo);
      actualizarTotal();
    }

    function actualizarTotal() {
      let total = 0;
      rowsBox.querySelectorAll('.c-row').forEach((row) => {
        const cant = Number((row.querySelector('.c-cant') as HTMLInputElement).value) || 0;
        const costo = Number((row.querySelector('.c-costo') as HTMLInputElement).value) || 0;
        const sub = cant * costo;
        (row.querySelector('.c-sub') as HTMLElement).textContent = fmt$(sub);
        total += sub;
      });
      document.getElementById('c-total')!.textContent = fmt$(total);
    }

    rowsBox.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      if (t.classList.contains('c-prod-search')) {
        const row = t.closest('.c-row')!;
        const select = row.querySelector('.c-prod') as HTMLSelectElement;
        select.innerHTML = opcionesProductos(select.value, (t as HTMLInputElement).value);
      }
      if (t.classList.contains('c-cant') || t.classList.contains('c-costo')) actualizarTotal();
      if (t.classList.contains('c-prod')) {
        const row = (t as HTMLElement).closest('.c-row')!;
        const opt = (t as HTMLSelectElement).selectedOptions[0] as HTMLOptionElement | undefined;
        if (opt?.dataset.costo) {
          (row.querySelector('.c-costo') as HTMLInputElement).value = opt.dataset.costo;
          actualizarTotal();
        }
      }
    });

    rowsBox.addEventListener('click', (e) => {
      const del = (e.target as HTMLElement).closest('.c-del') as HTMLElement | null;
      if (!del) return;
      if (rowsBox.querySelectorAll('.c-row').length <= 1) return;
      del.closest('.c-row')!.remove();
      actualizarTotal();
    });

    document.getElementById('c-add-row')!.addEventListener('click', () => agregarFila());

    const fileInput = document.getElementById('c-file') as HTMLInputElement;
    const sheetInput = document.getElementById('c-sheet') as HTMLSelectElement;
    const sheetBox = document.getElementById('c-sheet-box')!;
    const importStatus = document.getElementById('c-import-status')!;
    const importError = document.getElementById('c-import-error')!;
    let importing = false;

    document.getElementById('c-template')!.addEventListener('click', () => {
      const csv = '\uFEFFSKU;Producto;Variante;Cantidad;Costo unitario\r\nTU-SKU;Producto nombre;Única;10;1250,50\r\nSKU-BAM;Difusor Aromanza;Bambú;10;1250,50\r\nSKU-VAI;Difusor Aromanza;Vainilla;10;1250,50\r\n';
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'plantilla-compra-domus.csv';
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });

    async function importarArchivo(sheet?: string) {
      const file = fileInput.files?.[0];
      if (!file || importing) return;
      importing = true;
      fileInput.disabled = true;
      sheetInput.disabled = true;
      btn.disabled = true;
      importError.hidden = true;
      importStatus.textContent = 'Leyendo archivo…';
      try {
        const result = await readCompraFile(file, sheet);
        if (result.sheets.length > 1 && !sheet) {
          sheetInput.replaceChildren(new Option('Elegí una hoja', ''), ...result.sheets.map(name => new Option(name, name)));
          sheetBox.hidden = false;
          importStatus.textContent = 'Seleccioná la hoja que contiene la compra.';
          return;
        }
        // Obtener el catálogo actual antes de emparejar; nunca guardar durante la lectura.
        const response = await fetch('/api/admin/productos');
        if (!response.ok) throw new Error('No se pudo consultar el catálogo. Revisá tu sesión y volvé a intentar.');
        const catalog = await response.json();
        if (!Array.isArray(catalog)) throw new Error('No se pudo leer el catálogo.');
        const items = prepareCompraImport(result.rows, catalog);
        const currentRows = [...rowsBox.querySelectorAll<HTMLElement>('.c-row')];
        const emptyRows = currentRows.filter(row => !(row.querySelector('.c-prod') as HTMLSelectElement).value && !(row.querySelector('.c-costo') as HTMLInputElement).value && (row.querySelector('.c-cant') as HTMLInputElement).value === '1');
        if (currentRows.length - emptyRows.length + items.length > MAX_COMPRA_ROWS) throw new Error(`La compra no puede superar ${MAX_COMPRA_ROWS} filas, incluyendo las que ya cargaste.`);
        const selected = new Set(currentRows.map(row => (row.querySelector('.c-prod') as HTMLSelectElement).value));
        if (items.some(item => selected.has(item.producto_id))) throw new Error('El archivo incluye productos que ya están en la compra. Quitá esas filas antes de volver a importar para no duplicarlas.');
        productos = catalog;
        emptyRows.forEach(row => row.remove());
        items.forEach(item => agregarFila(item.producto_id, item.cantidad, item.costo_unitario));
        importStatus.textContent = `${file.name}${sheet ? ` · ${sheet}` : ''}: ${items.length} filas cargadas. Revisá los datos y hacé clic en Registrar compra. Todavía no se modificó el stock.`;
        sheetBox.hidden = true;
        fileInput.value = '';
      } catch (error) {
        importError.textContent = error instanceof Error ? error.message : 'No pudimos leer el archivo. Guardalo como .xlsx o CSV y volvé a intentar.';
        importError.hidden = false;
        importStatus.textContent = 'No se cargó ninguna fila del archivo. Tu compra actual se conserva.';
        fileInput.value = '';
        sheetBox.hidden = true;
      } finally {
        importing = false;
        fileInput.disabled = false;
        sheetInput.disabled = false;
        btn.disabled = false;
      }
    }
    fileInput.addEventListener('change', () => { sheetBox.hidden = true; importarArchivo(); });
    sheetInput.addEventListener('change', () => { if (sheetInput.value) importarArchivo(sheetInput.value); });

    // Alta rápida de producto: el formulario vive en un modal
    document.getElementById('c-new-prod-btn')!.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('domus:abrir-producto-modal'));
    });

    document.addEventListener('domus:producto-creado', ((e: CustomEvent<ProductoNuevo>) => {
      const creado = e.detail;
      if (!creado?.id) return;
      void cargarProductos().then(() => {
        const costo = Number(creado.costo);
        const conCosto = Number.isFinite(costo) && costo > 0;
        agregarFila(creado.id, 1, conCosto ? costo : undefined);
        const grupo = String(creado.grupo_id || '');
        okDiv.textContent = grupo
          ? `Variante "${creado.variante || ''}" de "${creado.nombre}" creada. Completá ${conCosto ? 'cantidad' : 'cantidad y costo'} en su fila.`
          : `Producto "${creado.nombre}" creado. Completá ${conCosto ? 'cantidad' : 'cantidad y costo'} en su fila.`;
        okDiv.style.display = 'block';
      });
    }) as EventListener);

    async function cargarProductos() {
      try {
        const res = await fetch('/api/admin/productos');
        if (!res.ok) return;
        productos = await res.json();
        rowsBox.querySelectorAll('.c-prod').forEach((s) => {
          const row = (s as HTMLElement).closest('.c-row')!;
          const filtro = (row.querySelector('.c-prod-search') as HTMLInputElement)?.value || '';
          (s as HTMLSelectElement).innerHTML = opcionesProductos((s as HTMLSelectElement).value, filtro);
        });
      } catch { /* noop */ }
    }

    async function cargarHistorial() {
      try {
        const res = await fetch('/api/admin/compras');
        if (!res.ok) return;
        const movs: Array<any> = await res.json();
        document.getElementById('c-historial')!.innerHTML = movs.length
          ? movs.map((m) => `<tr>
              <td>${new Date(m.fecha).toLocaleString('es-AR')}</td>
              <td>${escapeHtml(productoConVariante(m.productos))}</td>
              <td class="text-right">${m.cantidad}</td>
              <td class="text-right">${fmt$(Number(m.costo_unitario))}</td>
              <td class="text-right">${fmt$(Number(m.costo_total))}</td>
              <td>${escapeHtml(m.observaciones || '—')}</td>
            </tr>`).join('')
          : '<tr><td colspan="6" class="text-center">Sin compras registradas.</td></tr>';
      } catch { /* noop */ }
    }

    document.getElementById('compra-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (importing || btn.disabled) return;
      errDiv.style.display = 'none';
      okDiv.style.display = 'none';

      const items: Array<{ producto_id: string; cantidad: number; costo_unitario: number }> = [];
      for (const row of rowsBox.querySelectorAll('.c-row')) {
        const producto_id = (row.querySelector('.c-prod') as HTMLSelectElement).value;
        const cantidad = Number((row.querySelector('.c-cant') as HTMLInputElement).value);
        const costo_unitario = Number((row.querySelector('.c-costo') as HTMLInputElement).value);
        if (!producto_id || !Number.isSafeInteger(cantidad) || !(cantidad >= 1) || !Number.isFinite(costo_unitario) || !(costo_unitario >= 0)) {
          errDiv.textContent = 'Completá producto, cantidad y costo en todas las filas.';
          errDiv.style.display = 'block';
          return;
        }
        items.push({ producto_id, cantidad, costo_unitario });
      }
      if (!items.length || items.length > MAX_COMPRA_ROWS) {
        errDiv.textContent = `La compra debe tener entre 1 y ${MAX_COMPRA_ROWS} filas.`;
        errDiv.style.display = 'block';
        return;
      }

      btn.setAttribute('disabled', 'true');
      try {
        const res = await fetch('/api/admin/compras', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items,
            observaciones: (document.getElementById('c-obs') as HTMLInputElement).value.trim() || undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          errDiv.textContent = typeof data.error === 'string' ? data.error : JSON.stringify(data.error);
          errDiv.style.display = 'block';
          return;
        }
        okDiv.textContent = `Compra registrada: ${data.cantidad_items} productos por ${fmt$(Number(data.total))}.`;
        okDiv.style.display = 'block';
        importStatus.textContent = '';
        importError.hidden = true;
        rowsBox.innerHTML = '';
        agregarFila();
        (document.getElementById('c-obs') as HTMLInputElement).value = '';
        cargarHistorial();
        cargarProductos();
      } catch {
        errDiv.textContent = 'Error de conexión';
        errDiv.style.display = 'block';
      } finally {
        btn.removeAttribute('disabled');
      }
    });

    agregarFila();
    cargarProductos();
    cargarHistorial();
  </script>

  <style>
    .compra-import { padding: 1rem; margin-bottom: 1.5rem; border: 1px dashed var(--admin-border); border-radius: 8px; background: var(--admin-bg); }
    .compra-import h3 { font-size: 1rem; margin: 0 0 0.5rem; }
    .compra-import p { font-size: 0.8125rem; line-height: 1.6; margin: 0.5rem 0; }
    .compra-import-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 1rem 0; }
    .compra-import-actions label { width: 100%; }
    .compra-import-actions input { flex: 1; min-width: 0; max-width: 420px; }
    #c-import-error { white-space: pre-wrap; overflow-wrap: anywhere; }
    [hidden] { display: none !important; }
    @media (max-width: 700px) {
      .c-row {
        grid-template-columns: 1fr 1fr !important;
      }
      .c-row .admin-form-group:first-child {
        grid-column: 1 / -1;
      }
      .compra-import-actions > * { width: 100%; max-width: none; }
    }
    @media (max-width: 480px) {
      .c-row { grid-template-columns: 1fr !important; }
      .c-row .admin-form-group:first-child { grid-column: auto; }
    }
  </style>
</AdminLayout>
