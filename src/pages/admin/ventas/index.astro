---
// src/pages/admin/ventas/index.astro
// Registrar ventas manuales multi-producto + historial
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout title="Ventas">
  <h1 style="margin: 0 0 1.5rem; font-size: 1.5rem;">Ventas</h1>

  <div class="admin-card" style="margin-bottom: 1rem;">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Registrar venta</h2>
    <form id="venta-form" class="admin-form" style="max-width: none;">
      <div id="v-rows" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>

      <button type="button" id="v-add-row" class="admin-btn admin-btn-primary" style="margin-top: 0.75rem;">
        + Agregar producto
      </button>

      <div class="admin-card" style="padding: 1rem; margin-top: 1rem; background: var(--admin-bg);">
        <p style="margin: 0; font-size: 0.9375rem;" id="v-resumen">Agregá productos para ver el resumen.</p>
      </div>
      <div id="v-error" class="admin-alert admin-alert-error" style="display:none; margin-top: 1rem;"></div>
      <div id="v-ok" class="admin-alert admin-alert-success" style="display:none; margin-top: 1rem;"></div>
      <button type="submit" id="v-btn" class="admin-btn admin-btn-primary" style="margin-top: 1rem;">Registrar venta</button>
    </form>
    <p style="margin: 1rem 0 0; font-size: 0.8125rem; color: var(--admin-text-muted);">
      Descuenta stock de cada producto, usa el precio vigente (oferta si aplica) y calcula la ganancia sola.
      Si algún producto no tiene stock, no se registra nada.
    </p>
  </div>

  <div class="admin-card">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Historial</h2>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr><th>Fecha</th><th>Detalle</th><th class="text-right">Total</th><th class="text-right">Ganancia</th></tr>
        </thead>
        <tbody id="v-historial">
          <tr><td colspan="4" class="text-center">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const rowsBox = document.getElementById('v-rows')!;
    const errDiv = document.getElementById('v-error')!;
    const okDiv = document.getElementById('v-ok')!;
    const btn = document.getElementById('v-btn') as HTMLButtonElement;
    const fmt$ = (n: number) => `$${Math.round(n).toLocaleString('es-AR')}`;
    let productos: Array<any> = [];

    function opcionesProductos(selValue = ''): string {
      return '<option value="">— Elegí —</option>' + productos
        .map((p: any) => {
          const id = p.producto_id || p.id;
          return `<option value="${id}" ${id === selValue ? 'selected' : ''}>${p.nombre} (stock: ${p.stock_actual ?? 0})</option>`;
        })
        .join('');
    }

    function precioVigente(p: any): number {
      if (p.es_oferta && p.precio_oferta && Number(p.precio_oferta) < Number(p.precio_venta)) {
        return Number(p.precio_oferta);
      }
      return Number(p.precio_venta);
    }

    function agregarFila() {
      const row = document.createElement('div');
      row.className = 'v-row';
      row.style.cssText = 'display: grid; grid-template-columns: 2fr 1fr auto auto; gap: 0.5rem; align-items: end;';
      row.innerHTML = `
        <div class="admin-form-group">
          <label class="admin-form-label">Producto</label>
          <select class="admin-input v-prod" required>${opcionesProductos()}</select>
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">Cantidad</label>
          <input type="number" class="admin-input v-cant" min="1" step="1" value="1" required />
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">&nbsp;</label>
          <p class="v-sub" style="margin: 0; padding: 0.625rem 0; font-size: 0.875rem; font-weight: 600; white-space: nowrap;">$0</p>
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">&nbsp;</label>
          <button type="button" class="row-del v-del" aria-label="Quitar fila" title="Quitar fila">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>`;
      rowsBox.appendChild(row);
      actualizarResumen();
    }

    function filas(): Array<{ producto_id: string; cantidad: number }> {
      const out: Array<{ producto_id: string; cantidad: number }> = [];
      rowsBox.querySelectorAll('.v-row').forEach((row) => {
        out.push({
          producto_id: (row.querySelector('.v-prod') as HTMLSelectElement).value,
          cantidad: Number((row.querySelector('.v-cant') as HTMLInputElement).value) || 0,
        });
      });
      return out;
    }

    function actualizarResumen() {
      let total = 0;
      let ganancia = 0;
      let detalle = 0;
      rowsBox.querySelectorAll('.v-row').forEach((row) => {
        const pid = (row.querySelector('.v-prod') as HTMLSelectElement).value;
        const cant = Number((row.querySelector('.v-cant') as HTMLInputElement).value) || 0;
        const p = productos.find((x) => (x.producto_id || x.id) === pid);
        if (p && cant > 0) {
          const precio = precioVigente(p);
          const sub = precio * cant;
          (row.querySelector('.v-sub') as HTMLElement).textContent = fmt$(sub);
          total += sub;
          ganancia += (precio - Number(p.costo)) * cant;
          detalle++;
        } else {
          (row.querySelector('.v-sub') as HTMLElement).textContent = '$0';
        }
      });
      document.getElementById('v-resumen')!.innerHTML = detalle
        ? `Total: <strong>${fmt$(total)}</strong> · Ganancia est.: <strong>${fmt$(ganancia)}</strong> · ${detalle} producto(s)`
        : 'Agregá productos para ver el resumen.';
    }

    rowsBox.addEventListener('input', actualizarResumen);
    rowsBox.addEventListener('change', actualizarResumen);
    rowsBox.addEventListener('click', (e) => {
      const del = (e.target as HTMLElement).closest('.v-del') as HTMLElement | null;
      if (!del) return;
      if (rowsBox.querySelectorAll('.v-row').length <= 1) return;
      del.closest('.v-row')!.remove();
      actualizarResumen();
    });

    document.getElementById('v-add-row')!.addEventListener('click', agregarFila);

    async function cargarProductos() {
      try {
        const res = await fetch('/api/admin/productos');
        if (!res.ok) return;
        productos = await res.json();
        rowsBox.querySelectorAll('.v-prod').forEach((s) => {
          (s as HTMLSelectElement).innerHTML = opcionesProductos((s as HTMLSelectElement).value);
        });
        actualizarResumen();
      } catch { /* noop */ }
    }

    async function cargarHistorial() {
      try {
        const res = await fetch('/api/admin/ventas');
        if (!res.ok) return;
        const ventas: Array<any> = await res.json();
        document.getElementById('v-historial')!.innerHTML = ventas.length
          ? ventas.map((v) => {
              const detalle = (v.ventas_items || [])
                .map((i: any) => `${i.productos?.nombre || ''} ×${i.cantidad}`)
                .join(', ');
              return `<tr>
                <td>${new Date(v.fecha).toLocaleString('es-AR')}</td>
                <td>${detalle} <span style="color: var(--admin-text-muted); font-size: 0.75rem;">· ${v.source || ''}</span></td>
                <td class="text-right">${fmt$(Number(v.total))}</td>
                <td class="text-right">${fmt$(Number(v.ganancia))}</td>
              </tr>`;
            }).join('')
          : '<tr><td colspan="4" class="text-center">Sin ventas registradas.</td></tr>';
      } catch { /* noop */ }
    }

    document.getElementById('venta-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      errDiv.style.display = 'none';
      okDiv.style.display = 'none';

      const items = filas().filter((f) => f.producto_id && f.cantidad >= 1);
      if (!items.length) {
        errDiv.textContent = 'Agregá al menos un producto con cantidad.';
        errDiv.style.display = 'block';
        return;
      }

      btn.setAttribute('disabled', 'true');
      try {
        const res = await fetch('/api/admin/ventas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items }),
        });
        const data = await res.json();
        if (!res.ok) {
          errDiv.textContent = typeof data.error === 'string' ? data.error : JSON.stringify(data.error);
          errDiv.style.display = 'block';
          return;
        }
        okDiv.textContent = `Venta registrada: ${fmt$(Number(data.total))} (ganancia ${fmt$(Number(data.ganancia))})`;
        okDiv.style.display = 'block';
        rowsBox.innerHTML = '';
        agregarFila();
        cargarHistorial();
        cargarProductos();
      } catch {
        errDiv.textContent = 'Error de conexión';
        errDiv.style.display = 'block';
      } finally {
        btn.removeAttribute('disabled');
      }
    });

    agregarFila();
    cargarProductos();
    cargarHistorial();
  </script>

  <style>
    @media (max-width: 700px) {
      .v-row {
        grid-template-columns: 1fr 1fr !important;
      }
      .v-row .admin-form-group:first-child {
        grid-column: 1 / -1;
      }
    }
  </style>
</AdminLayout>
