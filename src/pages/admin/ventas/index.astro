---
// src/pages/admin/ventas/index.astro
// Ventas realizadas: historial con filtros, KPIs y anulación.
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import '@/styles/remito.css';
---

<AdminLayout title="Ventas">
  <div class="admin-card-header">
    <h1 style="margin: 0; font-size: 1.5rem;">Ventas realizadas</h1>
    <a href="/admin/pos" class="admin-btn admin-btn-success">+ Nueva venta</a>
  </div>

  <div class="v-kpis">
    <div class="v-kpi"><span>Ventas hoy</span><strong id="kpi-cant">—</strong></div>
    <div class="v-kpi"><span>Facturado hoy</span><strong id="kpi-total">—</strong></div>
    <div class="v-kpi"><span>Ganancia hoy</span><strong id="kpi-ganancia">—</strong></div>
  </div>

  <div class="admin-card">
    <div class="v-filtros">
      <input id="f-buscar" type="search" class="admin-input" placeholder="Buscar producto, cliente o #id…" aria-label="Buscar en ventas" autocomplete="off" />
      <select id="f-estado" class="admin-input" aria-label="Filtrar por estado">
        <option value="">Todos los estados</option>
        <option value="PAGADA">Pagada</option>
        <option value="COMPLETADA">Completada</option>
        <option value="CANCELADA">Anulada</option>
        <option value="PENDIENTE_EFECTIVO">Pendiente efectivo</option>
        <option value="PENDIENTE_PAGO">Pendiente pago</option>
        <option value="RECHAZADA">Rechazada</option>
      </select>
      <select id="f-metodo" class="admin-input" aria-label="Filtrar por medio de pago">
        <option value="">Todos los medios</option>
        <option value="EFECTIVO">Efectivo</option>
        <option value="TRANSFERENCIA">Transferencia</option>
        <option value="DEBITO">Débito</option>
        <option value="CREDITO">Crédito</option>
        <option value="MP">Mercado Pago</option>
        <option value="OTRO">Otro</option>
      </select>
      <select id="f-periodo" class="admin-input" aria-label="Filtrar por período">
        <option value="">Todo el período</option>
        <option value="hoy">Hoy</option>
        <option value="7">Últimos 7 días</option>
        <option value="30">Últimos 30 días</option>
      </select>
    </div>

    <p style="margin: 0 0 1rem; font-size: 0.8125rem; color: var(--admin-text-muted);">
      Las ventas del POS se pueden corregir mientras están <strong>pagadas</strong>; al completarlas quedan cerradas.
      Anular una venta manual devuelve el stock. Los pedidos de la tienda se gestionan en <a href="/admin/pedidos">Pedidos</a>.
    </p>

    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr><th>Fecha</th><th>Detalle</th><th class="text-right">Total</th><th class="text-right">Ganancia</th><th>Estado</th><th>Acciones</th></tr>
        </thead>
        <tbody id="v-historial">
          <tr><td colspan="6" class="text-center">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { ETIQUETAS_METODO_PAGO } from '../../../lib/precios';
    import { descargarComprobantePdf } from '../../../lib/admin-pdf';

    const fmt$ = (n: number) => `$${Math.round(n).toLocaleString('es-AR')}`;
    const varianteDe = (v?: string | null) => (v && v.trim() !== '' && v !== 'Única' ? ` — ${v}` : '');
    const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

    let ventasCache: Array<any> = [];
    let focoPrevio: HTMLElement | null = null;

    const buscarEl = document.getElementById('f-buscar') as HTMLInputElement;
    const estadoEl = document.getElementById('f-estado') as HTMLSelectElement;
    const metodoEl = document.getElementById('f-metodo') as HTMLSelectElement;
    const periodoEl = document.getElementById('f-periodo') as HTMLSelectElement;

    function esHoy(fecha: string): boolean {
      const d = new Date(fecha);
      const h = new Date();
      return d.getFullYear() === h.getFullYear() && d.getMonth() === h.getMonth() && d.getDate() === h.getDate();
    }

    function dentroPeriodo(fecha: string): boolean {
      const p = periodoEl.value;
      if (!p) return true;
      if (p === 'hoy') return esHoy(fecha);
      const dias = Number(p);
      const limite = Date.now() - dias * 24 * 60 * 60 * 1000;
      return new Date(fecha).getTime() >= limite;
    }

    function detalleDe(v: any): string {
      return (v.ventas_items || [])
        .map((i: any) => `${i.productos?.nombre || ''}${varianteDe(i.productos?.variante)} ×${i.cantidad}`)
        .join(', ');
    }

    function coincide(v: any, q: string): boolean {
      if (!q) return true;
      const texto = [
        detalleDe(v),
        v.cliente_nombre || '',
        String(v.id || ''),
      ]
        .join(' ')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();
      return texto.includes(q);
    }

    function filtradas(): Array<any> {
      const q = buscarEl.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
      return ventasCache.filter((v) =>
        coincide(v, q)
        && (!estadoEl.value || v.estado === estadoEl.value)
        && (!metodoEl.value || v.metodo_pago === metodoEl.value)
        && dentroPeriodo(v.fecha),
      );
    }

    function pintarKpis() {
      const hoy = ventasCache.filter((v) => esHoy(v.fecha));
      document.getElementById('kpi-cant')!.textContent = String(hoy.length);
      document.getElementById('kpi-total')!.textContent = fmt$(hoy.reduce((s, v) => s + Number(v.total || 0), 0));
      document.getElementById('kpi-ganancia')!.textContent = fmt$(hoy.reduce((s, v) => s + Number(v.ganancia || 0), 0));
    }

    function badgeEstado(estado: string, metodo: string, source?: string): string {
      const map: Record<string, string> = {
        PENDIENTE_EFECTIVO: 'background: #fffbeb; color: #744210;',
        PENDIENTE_PAGO: 'background: #ebf8ff; color: #2a4365;',
        PAGADA: 'background: #f0fff4; color: #22543d;',
        COMPLETADA: 'background: #f0fff4; color: #22543d;',
        RECHAZADA: 'background: #fff5f5; color: #742a2a;',
        CANCELADA: 'background: #fff5f5; color: #742a2a;',
        PENDIENTE: 'background: #fffbeb; color: #744210;',
      };
      const etiqueta = estado === 'PAGADA' && (source || 'MANUAL') === 'MANUAL'
        ? 'PAGADA · EDITABLE'
        : estado === 'CANCELADA' ? 'ANULADA' : estado;
      return `<span class="stock-badge" style="${map[estado] || ''}">${etiqueta || '—'}</span>`
        + (metodo ? `<br/><span style="font-size: 0.75rem; color: var(--admin-text-muted);">${ETIQUETAS_METODO_PAGO[metodo] || metodo}</span>` : '');
    }

    function pintar() {
      const ventas = filtradas();
      pintarKpis();
      document.getElementById('v-historial')!.innerHTML = ventas.length
        ? ventas.map((v) => {
            const detalle = detalleDe(v);
            const cliente = v.cliente_nombre
              ? `<br/><span style="font-size: 0.75rem; color: var(--admin-text-muted);">${esc(v.cliente_nombre)}</span>`
              : '';
            const manual = (v.source || 'MANUAL') === 'MANUAL';
            const editable = manual && v.estado === 'PAGADA';
            const anulable = manual && (v.estado === 'PAGADA' || v.estado === 'COMPLETADA');
            const acciones = `
              ${editable ? `<a class="admin-btn admin-btn-ghost" href="/admin/pos?editar=${v.id}">Editar</a>
              <button type="button" class="admin-btn admin-btn-success" data-v-completar="${v.id}">Completar</button>` : ''}
              ${anulable ? `<button type="button" class="admin-btn admin-btn-ghost" data-v-anular="${v.id}">Anular</button>` : ''}
              <button type="button" class="admin-btn admin-btn-ghost" data-v-nota="${v.id}" title="Ver nota de venta">Nota</button>`;
            return `<tr>
              <td>${new Date(v.fecha).toLocaleString('es-AR')}</td>
              <td>${detalle}${cliente}</td>
              <td class="text-right">${fmt$(Number(v.total))}</td>
              <td class="text-right">${fmt$(Number(v.ganancia))}</td>
              <td>${badgeEstado(v.estado, v.metodo_pago, v.source)}</td>
              <td><div class="v-row-actions">${acciones}</div></td>
            </tr>`;
          }).join('')
        : '<tr><td colspan="6" class="text-center">Sin ventas para estos filtros.</td></tr>';
    }

    async function cargarHistorial() {
      try {
        const res = await fetch('/api/admin/ventas', { cache: 'no-store' });
        if (!res.ok) return;
        const todas: Array<any> = await res.json();
        // Manuales todas + tienda solo realizadas (los pendientes viven en Pedidos)
        ventasCache = todas.filter((v) => {
          const source = v.source || 'MANUAL';
          if (source === 'MANUAL') return true;
          return v.estado === 'COMPLETADA' || v.estado === 'PAGADA';
        });
        pintar();
      } catch { /* noop */ }
    }

    buscarEl.addEventListener('input', pintar);
    estadoEl.addEventListener('change', pintar);
    metodoEl.addEventListener('change', pintar);
    periodoEl.addEventListener('change', pintar);

    // ---- Nota de venta imprimible ----
    const ESTADOS_NOTA: Record<string, string> = {
      COMPLETADA: 'Completada',
      PAGADA: 'Pagada',
      CANCELADA: 'Anulada',
      PENDIENTE_EFECTIVO: 'Pendiente de pago',
      PENDIENTE_PAGO: 'Pendiente de pago',
    };

    function cerrarNota() {
      document.getElementById('ven-ticket-root')?.remove();
      document.body.style.overflow = '';
      document.removeEventListener('keydown', escNota);
      focoPrevio?.focus();
      focoPrevio = null;
    }

    function escNota(e: KeyboardEvent) {
      if (e.key === 'Escape') cerrarNota();
    }

    function abrirNota(v: { id: string; fecha: string; total: number; metodo?: string | null; estado?: string | null; items: Array<{ nombre: string; variante?: string | null; cantidad: number; precio_unitario: number }> }) {
      cerrarNota();
      focoPrevio = document.activeElement as HTMLElement | null;
      const corto = String(v.id).slice(0, 8);
      const fecha = new Date(v.fecha).toLocaleString('es-AR');
      const filas = v.items.map((i) => {
        const pu = Number(i.precio_unitario ?? 0);
        const sub = pu * Number(i.cantidad ?? 0);
        return `<tr><td class="text-center">${i.cantidad}</td><td>${esc(i.nombre)}${varianteDe(i.variante)}</td><td class="text-right">$${pu.toLocaleString('es-AR')}</td><td class="text-right">$${sub.toLocaleString('es-AR')}</td></tr>`;
      }).join('') || '<tr><td colspan="4">—</td></tr>';

      const root = document.createElement('div');
      root.id = 'ven-ticket-root';
      root.className = 'ticket-root';
      root.innerHTML = `
      <div class="ticket-overlay">
        <div class="ticket-card">
          <div class="remito">
            <div class="rm-head">
              <div>
                <p class="rm-logo">DOMUS</p>
                <p class="rm-sub">tiendadomus.com.ar</p>
              </div>
              <div class="rm-doc">
                <p class="rm-doctitle">NOTA DE VENTA</p>
                <p class="rm-num">#${corto}</p>
                <p class="rm-fecha">${fecha}</p>
              </div>
            </div>
            <div class="rm-grid">
              <div><span>Medio de pago</span><strong>${ETIQUETAS_METODO_PAGO[v.metodo || ''] || v.metodo || '—'}</strong></div>
              <div><span>Estado</span><strong>${ESTADOS_NOTA[v.estado || ''] || v.estado || '—'}</strong></div>
            </div>
            <table class="rm-table">
              <thead><tr><th>Cant.</th><th>Detalle</th><th class="text-right">P. unit.</th><th class="text-right">Subtotal</th></tr></thead>
              <tbody>${filas}</tbody>
            </table>
            <div class="rm-total"><span>TOTAL</span><strong>$${Number(v.total ?? 0).toLocaleString('es-AR')}</strong></div>
            <p class="rm-foot">Gracias por tu compra · todo lo que hace de un lugar, hogar.</p>
          </div>
          <div class="ticket-actions no-print">
            <button class="admin-btn admin-btn-primary" id="ven-ticket-print">Imprimir</button>
            <button class="admin-btn admin-btn-success" id="ven-ticket-pdf">Descargar PDF</button>
            <button class="admin-btn admin-btn-ghost" id="ven-ticket-cerrar">Cerrar</button>
          </div>
        </div>
      </div>`;
      document.body.appendChild(root);
      document.body.style.overflow = 'hidden';

      root.querySelector('#ven-ticket-cerrar')!.addEventListener('click', cerrarNota);
      root.querySelector('.ticket-overlay')!.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).classList.contains('ticket-overlay')) cerrarNota();
      });
      root.querySelector('#ven-ticket-print')!.addEventListener('click', () => window.print());
      root.querySelector('#ven-ticket-pdf')!.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        button.textContent = 'Generando…';
        try {
          descargarComprobantePdf({
            id: v.id,
            fecha: v.fecha,
            total: v.total,
            titulo: 'Nota de venta',
            datos: [
              ['Medio de pago', ETIQUETAS_METODO_PAGO[v.metodo || ''] || v.metodo || '—'],
              ['Estado', ESTADOS_NOTA[v.estado || ''] || v.estado || '—'],
            ],
            items: v.items,
          });
        } catch {
          window.alert('No pudimos generar el PDF. Volvé a intentarlo.');
        } finally {
          button.disabled = false;
          button.textContent = 'Descargar PDF';
        }
      });
      document.addEventListener('keydown', escNota);
      (root.querySelector('#ven-ticket-print') as HTMLButtonElement | null)?.focus();
    }

    function itemsDeHistorial(v: any) {
      return (v.ventas_items || []).map((i: any) => ({
        nombre: i.productos?.nombre || '', variante: i.productos?.variante,
        cantidad: i.cantidad, precio_unitario: i.precio_unitario,
      }));
    }

    function mostrarAviso(texto: string) {
      const w = window as unknown as { adminToast?: (m: string) => void };
      if (w.adminToast) { w.adminToast(texto); return; }
      window.alert(texto);
    }

    async function completarVenta(v: any, button: HTMLButtonElement) {
      if (!window.confirm(`Completar la venta #${String(v.id).slice(0, 8)}? Después no se podrá editar.`)) return;
      button.disabled = true;
      const texto = button.textContent;
      button.textContent = 'Completando…';
      try {
        const res = await fetch(`/api/admin/ventas/${v.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'completar' }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(typeof data.error === 'string' ? data.error : 'No se pudo completar.');
        mostrarAviso(`Venta #${String(v.id).slice(0, 8)} completada.`);
        await cargarHistorial();
      } catch (error) {
        mostrarAviso(error instanceof Error ? error.message : 'Error de conexión.');
      } finally {
        button.disabled = false;
        button.textContent = texto;
      }
    }

    async function anularVenta(v: any, button: HTMLButtonElement) {
      if (!window.confirm(`Anular la venta #${String(v.id).slice(0, 8)}? Se devuelve el stock y no se puede deshacer.`)) return;
      button.disabled = true;
      const texto = button.textContent;
      button.textContent = 'Anulando…';
      try {
        const res = await fetch(`/api/admin/ventas/${v.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'anular' }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(typeof data.error === 'string' ? data.error : 'No se pudo anular.');
        mostrarAviso(`Venta #${String(v.id).slice(0, 8)} anulada. Stock devuelto.`);
        await cargarHistorial();
      } catch (error) {
        mostrarAviso(error instanceof Error ? error.message : 'Error de conexión.');
      } finally {
        button.disabled = false;
        button.textContent = texto;
      }
    }

    document.getElementById('v-historial')!.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest('[data-v-nota], [data-v-completar], [data-v-anular]') as HTMLElement | null;
      if (!action) return;
      const id = action.getAttribute('data-v-nota') || action.getAttribute('data-v-completar') || action.getAttribute('data-v-anular');
      const v = ventasCache.find((x) => x.id === id);
      if (!v) return;
      if (action.hasAttribute('data-v-completar')) void completarVenta(v, action as HTMLButtonElement);
      else if (action.hasAttribute('data-v-anular')) void anularVenta(v, action as HTMLButtonElement);
      else abrirNota({ id: v.id, fecha: v.fecha, total: Number(v.total), metodo: v.metodo_pago, estado: v.estado, items: itemsDeHistorial(v) });
    });

    const qInicial = new URLSearchParams(window.location.search).get('q');
    if (qInicial) buscarEl.value = qInicial;
    cargarHistorial();
  </script>

  <style is:global>
    .v-kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .v-kpi {
      background: #fff;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 0.875rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .v-kpi span {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--admin-text-muted);
    }

    .v-kpi strong {
      font-size: 1.375rem;
    }

    .v-filtros {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .v-row-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }

    .v-row-actions .admin-btn {
      min-height: 44px;
      padding: 0.375rem 0.7rem;
      font-size: 0.78rem;
    }

    @media (max-width: 800px) {
      .v-filtros {
        grid-template-columns: 1fr 1fr;
      }
      .v-filtros #f-buscar {
        grid-column: 1 / -1;
      }
    }
  </style>
</AdminLayout>
