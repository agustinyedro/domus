---
// src/pages/admin/ventas/index.astro
// Registrar ventas manuales multi-producto + historial
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import '@/styles/remito.css';
---

<AdminLayout title="Ventas">
  <h1 style="margin: 0 0 1.5rem; font-size: 1.5rem;">Ventas</h1>

  <div class="admin-card" style="margin-bottom: 1rem;">
    <h2 id="v-form-title" class="admin-card-title" style="margin-bottom: 1rem;">Registrar venta</h2>
    <form id="venta-form" class="admin-form" style="max-width: none;">
      <div class="admin-form-group" style="max-width: 22rem;">
        <label class="admin-form-label" for="v-metodo">Medio de pago</label>
        <select id="v-metodo" class="admin-input" required>
          <option value="">— Elegí —</option>
          <option value="EFECTIVO">Efectivo</option>
          <option value="TRANSFERENCIA">Transferencia</option>
          <option value="DEBITO">Débito</option>
          <option value="CREDITO">Crédito</option>
          <option value="MP">Mercado Pago</option>
          <option value="OTRO">Otro</option>
        </select>
      </div>

      <div id="v-rows" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>

      <button type="button" id="v-add-row" class="admin-btn admin-btn-primary" style="margin-top: 0.75rem;">
        + Agregar producto
      </button>

      <div class="admin-card" style="padding: 1rem; margin-top: 1rem; background: var(--admin-bg);">
        <p style="margin: 0; font-size: 0.9375rem;" id="v-resumen">Agregá productos para ver el resumen.</p>
      </div>
      <div id="v-error" class="admin-alert admin-alert-error" style="display:none; margin-top: 1rem;"></div>
      <div id="v-ok" class="admin-alert admin-alert-success" style="display:none; margin-top: 1rem;"></div>
      <div class="v-form-actions">
        <button type="submit" id="v-btn" class="admin-btn admin-btn-primary">Registrar venta</button>
        <button type="button" id="v-cancel-edit" class="admin-btn admin-btn-ghost" hidden>Cancelar edición</button>
      </div>
    </form>
    <p style="margin: 1rem 0 0; font-size: 0.8125rem; color: var(--admin-text-muted);">
      Descuenta stock de cada producto, usa el precio vigente (oferta si aplica) y calcula la ganancia sola.
      Con <strong>Efectivo</strong> o <strong>Transferencia</strong> se cobra el precio en efectivo; con los demás medios, el precio de tarjeta (recargo por producto). Se calcula en el servidor.
      La venta queda pagada y editable hasta que uses <strong>Completar</strong>. Si algún producto no tiene stock, no se registra nada.
    </p>
  </div>

  <div class="admin-card">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Historial</h2>
    <p style="margin: 0 0 1rem; font-size: 0.8125rem; color: var(--admin-text-muted);">
      Las ventas manuales pagadas se pueden corregir. Al completarlas quedan cerradas definitivamente.
      Los pendientes se gestionan en <a href="/admin/pedidos">Pedidos</a>.
    </p>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr><th>Fecha</th><th>Detalle</th><th class="text-right">Total</th><th class="text-right">Ganancia</th><th>Estado</th><th>Acciones</th></tr>
        </thead>
        <tbody id="v-historial">
          <tr><td colspan="6" class="text-center">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { esPagoSinRecargo, precioEfectivo, RECARGO_TARJETA_DEFAULT, ETIQUETAS_METODO_PAGO } from '../../../lib/precios';
    import { descargarComprobantePdf } from '../../../lib/admin-pdf';

    const rowsBox = document.getElementById('v-rows')!;
    const metodoSel = document.getElementById('v-metodo') as HTMLSelectElement;
    const errDiv = document.getElementById('v-error')!;
    const okDiv = document.getElementById('v-ok')!;
    const btn = document.getElementById('v-btn') as HTMLButtonElement;
    const fmt$ = (n: number) => `$${Math.round(n).toLocaleString('es-AR')}`;
    let productos: Array<any> = [];
    let ventasCache: Array<any> = [];
    let ultimaVenta: any = null;
    let focoPrevio: HTMLElement | null = null;
    let ventaEditandoId: string | null = null;

    const esSinRecargo = () => esPagoSinRecargo(metodoSel.value);
    const labelTotal = () => (metodoSel.value === 'TRANSFERENCIA' ? 'Total transferencia' : 'Total efectivo');

    const varianteDe = (v?: string | null) => (v && v.trim() !== '' && v !== 'Única' ? ` — ${v}` : '');
    const normalizarBusqueda = (value: unknown) => String(value ?? '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

    function opcionesProductos(selValue = '', filtro = ''): string {
      const query = normalizarBusqueda(filtro);
      const encontrados = productos.filter((p: any) => {
        const id = p.producto_id || p.id;
        return id === selValue || !query || normalizarBusqueda(`${p.nombre} ${p.variante || ''} ${p.nombre_opcion || ''} ${p.sku || ''}`).includes(query);
      });
      const vacio = query && encontrados.length === 0 ? '<option value="">Sin coincidencias</option>' : '<option value="">— Elegí —</option>';
      return vacio + encontrados
        .map((p: any) => {
          const id = p.producto_id || p.id;
          return `<option value="${id}" ${id === selValue ? 'selected' : ''}>${p.nombre}${varianteDe(p.variante)} (stock: ${p.stock_actual ?? 0})</option>`;
        })
        .join('');
    }

    function precioVigente(p: any): number {
      if (p.es_oferta && p.precio_oferta && Number(p.precio_oferta) < Number(p.precio_venta)) {
        return Number(p.precio_oferta);
      }
      return Number(p.precio_venta);
    }

    function recargoDe(p: any): number {
      const r = Number(p.recargo_tarjeta);
      return Number.isFinite(r) ? r : RECARGO_TARJETA_DEFAULT;
    }

  function precioDe(p: any): number {
    const vigente = precioVigente(p);
    return esSinRecargo() ? precioEfectivo(vigente, recargoDe(p)) : vigente;
  }

    function agregarFila(selValue = '', cantidad = 1) {
      const row = document.createElement('div');
      row.className = 'v-row';
      row.style.cssText = 'display: grid; grid-template-columns: 2fr 1fr auto auto; gap: 0.5rem; align-items: end;';
      row.innerHTML = `
        <div class="admin-form-group">
          <label class="admin-form-label">Producto</label>
          <input type="search" class="admin-input product-search v-prod-search" placeholder="Buscar por nombre, opción o SKU…" aria-label="Buscar producto" autocomplete="off" />
          <select class="admin-input v-prod" required>${opcionesProductos(selValue)}</select>
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">Cantidad</label>
          <input type="number" class="admin-input v-cant" min="1" step="1" value="1" required />
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">&nbsp;</label>
          <p class="v-sub" style="margin: 0; padding: 0.625rem 0; font-size: 0.875rem; font-weight: 600; white-space: nowrap;">$0</p>
        </div>
        <div class="admin-form-group">
          <label class="admin-form-label">&nbsp;</label>
          <button type="button" class="row-del v-del" aria-label="Quitar fila" title="Quitar fila">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>`;
      rowsBox.appendChild(row);
      (row.querySelector('.v-cant') as HTMLInputElement).value = String(cantidad);
      actualizarResumen();
    }

    function filas(): Array<{ producto_id: string; cantidad: number }> {
      const out: Array<{ producto_id: string; cantidad: number }> = [];
      rowsBox.querySelectorAll('.v-row').forEach((row) => {
        out.push({
          producto_id: (row.querySelector('.v-prod') as HTMLSelectElement).value,
          cantidad: Number((row.querySelector('.v-cant') as HTMLInputElement).value) || 0,
        });
      });
      return out;
    }

    function actualizarResumen() {
      let totalLista = 0;
      let total = 0;
      let ganancia = 0;
      let detalle = 0;
      rowsBox.querySelectorAll('.v-row').forEach((row) => {
        const pid = (row.querySelector('.v-prod') as HTMLSelectElement).value;
        const cant = Number((row.querySelector('.v-cant') as HTMLInputElement).value) || 0;
        const p = productos.find((x) => (x.producto_id || x.id) === pid);
        if (p && cant > 0) {
          const precio = precioDe(p);
          const sub = precio * cant;
          (row.querySelector('.v-sub') as HTMLElement).textContent = fmt$(sub);
          totalLista += precioVigente(p) * cant;
          total += sub;
          ganancia += (precio - Number(p.costo)) * cant;
          detalle++;
        } else {
          (row.querySelector('.v-sub') as HTMLElement).textContent = '$0';
        }
      });
      if (!detalle) {
        document.getElementById('v-resumen')!.textContent = 'Agregá productos para ver el resumen.';
        return;
      }
      const cierre = `${detalle} producto(s)`;
      document.getElementById('v-resumen')!.innerHTML = esSinRecargo()
        ? `Total tarjeta: <s>${fmt$(totalLista)}</s> · ${labelTotal()}: <strong>${fmt$(total)}</strong> · Ganancia est.: <strong>${fmt$(ganancia)}</strong> · ${cierre}`
        : `Total: <strong>${fmt$(total)}</strong> · Ganancia est.: <strong>${fmt$(ganancia)}</strong> · ${cierre}`;
    }

    metodoSel.addEventListener('change', actualizarResumen);

    rowsBox.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('v-prod-search')) {
        const row = target.closest('.v-row')!;
        const select = row.querySelector('.v-prod') as HTMLSelectElement;
        select.innerHTML = opcionesProductos(select.value, (target as HTMLInputElement).value);
      }
      actualizarResumen();
    });
    rowsBox.addEventListener('change', actualizarResumen);
    rowsBox.addEventListener('click', (e) => {
      const del = (e.target as HTMLElement).closest('.v-del') as HTMLElement | null;
      if (!del) return;
      if (rowsBox.querySelectorAll('.v-row').length <= 1) return;
      del.closest('.v-row')!.remove();
      actualizarResumen();
    });

    document.getElementById('v-add-row')!.addEventListener('click', () => agregarFila());

    async function cargarProductos() {
      try {
        const res = await fetch('/api/admin/productos');
        if (!res.ok) return;
        productos = await res.json();
        rowsBox.querySelectorAll('.v-prod').forEach((s) => {
          const row = (s as HTMLElement).closest('.v-row')!;
          const filtro = (row.querySelector('.v-prod-search') as HTMLInputElement)?.value || '';
          (s as HTMLSelectElement).innerHTML = opcionesProductos((s as HTMLSelectElement).value, filtro);
        });
        actualizarResumen();
      } catch { /* noop */ }
    }

    async function cargarHistorial() {
      try {
        const res = await fetch('/api/admin/ventas', { cache: 'no-store' });
        if (!res.ok) return;
        const todas: Array<any> = await res.json();
        // Manuales todas + tienda solo realizadas (los pendientes viven en Pedidos)
        const ventas = todas.filter((v) => {
          const source = v.source || 'MANUAL';
          if (source === 'MANUAL') return true;
          return v.estado === 'COMPLETADA' || v.estado === 'PAGADA';
        });
        ventasCache = ventas;
        document.getElementById('v-historial')!.innerHTML = ventas.length
          ? ventas.map((v) => {
              const detalle = (v.ventas_items || [])
                .map((i: any) => `${i.productos?.nombre || ''}${varianteDe(i.productos?.variante)} ×${i.cantidad}`)
                .join(', ');
              const editable = (v.source || 'MANUAL') === 'MANUAL' && v.estado === 'PAGADA';
              const acciones = `${editable ? `
                <button type="button" class="admin-btn admin-btn-ghost" data-v-editar="${v.id}">Editar</button>
                <button type="button" class="admin-btn admin-btn-success" data-v-completar="${v.id}">Completar</button>` : ''}
                <button type="button" class="admin-btn admin-btn-ghost" data-v-nota="${v.id}" title="Ver nota de venta">Nota</button>`;
              return `<tr>
                <td>${new Date(v.fecha).toLocaleString('es-AR')}</td>
                <td>${detalle}</td>
                <td class="text-right">${fmt$(Number(v.total))}</td>
                <td class="text-right">${fmt$(Number(v.ganancia))}</td>
                <td>${badgeEstado(v.estado, v.metodo_pago, v.source)}</td>
                <td><div class="v-row-actions">${acciones}</div></td>
              </tr>`;
            }).join('')
          : '<tr><td colspan="6" class="text-center">Sin ventas registradas.</td></tr>';
      } catch { /* noop */ }
    }

    function badgeEstado(estado: string, metodo: string, source?: string): string {
      const map: Record<string, string> = {
        'PENDIENTE_EFECTIVO': 'background: #fffbeb; color: #744210;',
        'PENDIENTE_PAGO': 'background: #ebf8ff; color: #2a4365;',
        'PAGADA': 'background: #f0fff4; color: #22543d;',
        'COMPLETADA': 'background: #f0fff4; color: #22543d;',
        'RECHAZADA': 'background: #fff5f5; color: #742a2a;',
        'CANCELADA': 'background: #f7fafc; color: #4a5568;',
        'PENDIENTE': 'background: #fffbeb; color: #744210;',
      };
      const etiqueta = estado === 'PAGADA' && (source || 'MANUAL') === 'MANUAL' ? 'PAGADA · EDITABLE' : estado;
      return `<span class="stock-badge" style="${map[estado] || ''}">${etiqueta || '—'}</span>`
        + (metodo ? `<br/><span style="font-size: 0.75rem; color: var(--admin-text-muted);">${ETIQUETAS_METODO_PAGO[metodo] || metodo}</span>` : '');
    }

    // ---- Nota de venta imprimible ----
    const ESTADOS_NOTA: Record<string, string> = {
      COMPLETADA: 'Completada',
      PAGADA: 'Pagada',
      PENDIENTE_EFECTIVO: 'Pendiente de pago',
      PENDIENTE_PAGO: 'Pendiente de pago',
    };

    function cerrarNota() {
      document.getElementById('ven-ticket-root')?.remove();
      document.body.style.overflow = '';
      document.removeEventListener('keydown', escNota);
      focoPrevio?.focus();
      focoPrevio = null;
    }

    function escNota(e: KeyboardEvent) {
      if (e.key === 'Escape') cerrarNota();
    }

    function abrirNota(v: { id: string; fecha: string; total: number; metodo?: string | null; estado?: string | null; items: Array<{ nombre: string; variante?: string | null; cantidad: number; precio_unitario: number }> }) {
      cerrarNota();
      focoPrevio = document.activeElement as HTMLElement | null;
      const corto = String(v.id).slice(0, 8);
      const fecha = new Date(v.fecha).toLocaleString('es-AR');
      const filas = v.items.map((i) => {
        const pu = Number(i.precio_unitario ?? 0);
        const sub = pu * Number(i.cantidad ?? 0);
        return `<tr><td class="text-center">${i.cantidad}</td><td>${i.nombre}${varianteDe(i.variante)}</td><td class="text-right">$${pu.toLocaleString('es-AR')}</td><td class="text-right">$${sub.toLocaleString('es-AR')}</td></tr>`;
      }).join('') || '<tr><td colspan="4">—</td></tr>';

      const root = document.createElement('div');
      root.id = 'ven-ticket-root';
      root.className = 'ticket-root';
      root.innerHTML = `
      <div class="ticket-overlay">
        <div class="ticket-card">
          <div class="remito">
            <div class="rm-head">
              <div>
                <p class="rm-logo">DOMUS</p>
                <p class="rm-sub">domus.com.ar</p>
              </div>
              <div class="rm-doc">
                <p class="rm-doctitle">NOTA DE VENTA</p>
                <p class="rm-num">#${corto}</p>
                <p class="rm-fecha">${fecha}</p>
              </div>
            </div>
            <div class="rm-grid">
              <div><span>Medio de pago</span><strong>${ETIQUETAS_METODO_PAGO[v.metodo || ''] || v.metodo || '—'}</strong></div>
              <div><span>Estado</span><strong>${ESTADOS_NOTA[v.estado || ''] || v.estado || '—'}</strong></div>
            </div>
            <table class="rm-table">
              <thead><tr><th>Cant.</th><th>Detalle</th><th class="text-right">P. unit.</th><th class="text-right">Subtotal</th></tr></thead>
              <tbody>${filas}</tbody>
            </table>
            <div class="rm-total"><span>TOTAL</span><strong>$${Number(v.total ?? 0).toLocaleString('es-AR')}</strong></div>
            <p class="rm-foot">Gracias por tu compra · todo lo que hace de un lugar, hogar.</p>
          </div>
          <div class="ticket-actions no-print">
            <button class="admin-btn admin-btn-primary" id="ven-ticket-print">Imprimir</button>
            <button class="admin-btn admin-btn-success" id="ven-ticket-pdf">Descargar PDF</button>
            <button class="admin-btn admin-btn-ghost" id="ven-ticket-cerrar">Cerrar</button>
          </div>
        </div>
      </div>`;
      document.body.appendChild(root);
      document.body.style.overflow = 'hidden';

      root.querySelector('#ven-ticket-cerrar')!.addEventListener('click', cerrarNota);
      root.querySelector('.ticket-overlay')!.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).classList.contains('ticket-overlay')) cerrarNota();
      });
      root.querySelector('#ven-ticket-print')!.addEventListener('click', () => window.print());
      root.querySelector('#ven-ticket-pdf')!.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        button.textContent = 'Generando…';
        try {
          await descargarComprobantePdf({
            id: v.id,
            fecha: v.fecha,
            total: v.total,
            titulo: 'Nota de venta',
            datos: [
              ['Medio de pago', ETIQUETAS_METODO_PAGO[v.metodo || ''] || v.metodo || '—'],
              ['Estado', ESTADOS_NOTA[v.estado || ''] || v.estado || '—'],
            ],
            items: v.items,
          });
        } catch {
          window.alert('No pudimos generar el PDF. Volvé a intentarlo.');
        } finally {
          button.disabled = false;
          button.textContent = 'Descargar PDF';
        }
      });
      document.addEventListener('keydown', escNota);
      (root.querySelector('#ven-ticket-print') as HTMLButtonElement | null)?.focus();
    }

    function itemsDeAlta(data: any) {
      return (data.items || []).map((i: any) => ({
        nombre: i.nombre, variante: i.variante, cantidad: i.cantidad, precio_unitario: i.precio,
      }));
    }

    function itemsDeHistorial(v: any) {
      return (v.ventas_items || []).map((i: any) => ({
        nombre: i.productos?.nombre || '', variante: i.productos?.variante,
        cantidad: i.cantidad, precio_unitario: i.precio_unitario,
      }));
    }

    function salirEdicion() {
      ventaEditandoId = null;
      document.getElementById('v-form-title')!.textContent = 'Registrar venta';
      btn.textContent = 'Registrar venta';
      (document.getElementById('v-cancel-edit') as HTMLButtonElement).hidden = true;
      metodoSel.value = '';
      rowsBox.innerHTML = '';
      agregarFila();
    }

    function editarVenta(v: any) {
      if ((v.source || 'MANUAL') !== 'MANUAL' || v.estado !== 'PAGADA') return;
      ventaEditandoId = v.id;
      document.getElementById('v-form-title')!.textContent = `Editar venta #${String(v.id).slice(0, 8)}`;
      btn.textContent = 'Guardar cambios';
      (document.getElementById('v-cancel-edit') as HTMLButtonElement).hidden = false;
      metodoSel.value = v.metodo_pago || '';
      rowsBox.innerHTML = '';
      (v.ventas_items || []).forEach((item: any) => agregarFila(item.producto_id, Number(item.cantidad) || 1));
      if (!v.ventas_items?.length) agregarFila();
      document.getElementById('venta-form')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function completarVenta(v: any, button: HTMLButtonElement) {
      if (!window.confirm(`Completar la venta #${String(v.id).slice(0, 8)}? Después no se podrá editar.`)) return;
      errDiv.style.display = 'none';
      button.disabled = true;
      const texto = button.textContent;
      button.textContent = 'Completando…';
      try {
        const res = await fetch(`/api/admin/ventas/${v.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accion: 'completar' }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(typeof data.error === 'string' ? data.error : 'No se pudo completar la venta.');
        if (ventaEditandoId === v.id) salirEdicion();
        okDiv.textContent = `Venta #${String(v.id).slice(0, 8)} completada. Ya no se puede editar.`;
        okDiv.style.display = 'block';
        await cargarHistorial();
      } catch (error) {
        errDiv.textContent = error instanceof Error ? error.message : 'Error de conexión.';
        errDiv.style.display = 'block';
      } finally {
        button.disabled = false;
        button.textContent = texto;
      }
    }

    document.getElementById('v-historial')!.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest('[data-v-nota], [data-v-editar], [data-v-completar]') as HTMLElement | null;
      if (!action) return;
      const id = action.getAttribute('data-v-nota') || action.getAttribute('data-v-editar') || action.getAttribute('data-v-completar');
      const v = ventasCache.find((x) => x.id === id);
      if (!v) return;
      if (action.hasAttribute('data-v-editar')) editarVenta(v);
      else if (action.hasAttribute('data-v-completar')) void completarVenta(v, action as HTMLButtonElement);
      else abrirNota({ id: v.id, fecha: v.fecha, total: Number(v.total), metodo: v.metodo_pago, estado: v.estado, items: itemsDeHistorial(v) });
    });

    document.getElementById('v-cancel-edit')!.addEventListener('click', salirEdicion);

    okDiv.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#v-print-nota') || !ultimaVenta) return;
      abrirNota(ultimaVenta);
    });

    document.getElementById('venta-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      errDiv.style.display = 'none';
      okDiv.style.display = 'none';

      const items = filas().filter((f) => f.producto_id && f.cantidad >= 1);
      if (!items.length) {
        errDiv.textContent = 'Agregá al menos un producto con cantidad.';
        errDiv.style.display = 'block';
        return;
      }

      btn.setAttribute('disabled', 'true');
      try {
        const editando = ventaEditandoId;
        const res = await fetch(editando ? `/api/admin/ventas/${editando}` : '/api/admin/ventas', {
          method: editando ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...(editando ? { accion: 'editar' } : {}), items, metodo_pago: metodoSel.value }),
        });
        const data = await res.json();
        if (!res.ok) {
          errDiv.textContent = typeof data.error === 'string' ? data.error : JSON.stringify(data.error);
          errDiv.style.display = 'block';
          return;
        }
        ultimaVenta = editando
          ? { id: data.id, fecha: data.fecha, total: Number(data.total), metodo: data.metodo_pago, estado: data.estado, items: itemsDeHistorial(data) }
          : { id: data.id, fecha: data.fecha, total: Number(data.total), metodo: data.metodo_pago, estado: data.estado, items: itemsDeAlta(data) };
        okDiv.innerHTML = `<span>${editando ? 'Venta actualizada' : 'Venta registrada'}: ${fmt$(Number(data.total))} (ganancia ${fmt$(Number(data.ganancia))})</span> <button type="button" class="admin-btn admin-btn-ghost" id="v-print-nota" style="min-height: 44px; margin-left: 0.5rem;">Ver nota</button>`;
        okDiv.style.display = 'block';
        salirEdicion();
        cargarHistorial();
        cargarProductos();
      } catch {
        errDiv.textContent = 'Error de conexión';
        errDiv.style.display = 'block';
      } finally {
        btn.removeAttribute('disabled');
      }
    });

    agregarFila();
    cargarProductos();
    cargarHistorial();
  </script>

  <style>
    .v-form-actions, .v-row-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }

    .v-form-actions { margin-top: 1rem; }
    .v-row-actions .admin-btn { min-height: 44px; padding: 0.375rem 0.7rem; font-size: 0.78rem; }

    @media (max-width: 700px) {
      .v-row {
        grid-template-columns: 1fr 1fr !important;
      }
      .v-row .admin-form-group:first-child {
        grid-column: 1 / -1;
      }
      .v-form-actions .admin-btn { flex: 1 1 10rem; }
      .v-row-actions { min-width: 12rem; }
    }
    @media (max-width: 480px) {
      .v-row { grid-template-columns: 1fr !important; }
      .v-row .admin-form-group:first-child { grid-column: auto; }
    }
  </style>
</AdminLayout>
