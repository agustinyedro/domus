---
// src/pages/admin/stock/index.astro
// Ajustes de stock con motivo (no son ventas)
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout title="Stock">
  <h1 style="margin: 0 0 0.5rem; font-size: 1.5rem;">Stock</h1>
  <p style="margin: 0 0 1.5rem; color: var(--admin-text-muted); font-size: 0.9375rem;">
    Foto actual del stock de cada producto. Tocá una fila para ver el detalle.
  </p>

  <div id="stock-chips" style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem;"></div>

  <div class="admin-card" style="margin-bottom: 1rem;">
    <h2 class="admin-card-title" style="margin-bottom: 0.5rem;">Ajustar stock</h2>
    <p style="margin: 0 0 1rem; font-size: 0.8125rem; color: var(--admin-text-muted);">
      Para salidas que no son ventas (ej: te los llevás a casa, muestras, roturas).
      Siempre con motivo y nunca deja el stock en negativo.
    </p>
    <form id="mov-form" class="admin-form">
      <div class="admin-form-group">
        <label class="admin-form-label" for="mov-producto">Producto</label>
        <select id="mov-producto" class="admin-input" required>
          <option value="">Cargando productos…</option>
        </select>
        <p id="mov-stock-actual" style="margin: 0.25rem 0 0; font-size: 0.8125rem; color: var(--admin-text-muted);"></p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="admin-form-group">
          <label class="admin-form-label">Tipo</label>
          <div style="display: flex; gap: 0.5rem;">
            <label style="flex: 1; display: flex; align-items: center; gap: 0.5rem; padding: 0.625rem; border: 1px solid var(--admin-border); border-radius: 6px; cursor: pointer; font-size: 0.875rem;">
              <input type="radio" name="mov-tipo" value="SALIDA" checked /> Salida (−)
            </label>
            <label style="flex: 1; display: flex; align-items: center; gap: 0.5rem; padding: 0.625rem; border: 1px solid var(--admin-border); border-radius: 6px; cursor: pointer; font-size: 0.875rem;">
              <input type="radio" name="mov-tipo" value="ENTRADA" /> Entrada (+)
            </label>
          </div>
        </div>

        <div class="admin-form-group">
          <label class="admin-form-label" for="mov-cantidad">Cantidad</label>
          <input id="mov-cantidad" type="number" class="admin-input" min="1" step="1" value="1" required />
        </div>
      </div>

      <div class="admin-form-group">
        <label class="admin-form-label" for="mov-motivo">Motivo (obligatorio)</label>
        <input
          id="mov-motivo"
          type="text"
          class="admin-input"
          required
          minlength="3"
          maxlength="500"
          placeholder="Ej: me los llevo a casa"
        />
      </div>

      <div id="mov-error" class="admin-alert admin-alert-error" style="display:none;"></div>
      <div id="mov-ok" class="admin-alert admin-alert-success" style="display:none;"></div>

      <button type="submit" id="mov-btn" class="admin-btn admin-btn-primary">Registrar movimiento</button>
    </form>
  </div>

  <div class="admin-card" style="margin-bottom: 1rem;">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Productos</h2>
    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
      <input id="stock-q" type="search" class="admin-input" placeholder="Buscar producto…" />
      <select id="stock-cat" class="admin-input" aria-label="Filtrar por categoría">
        <option value="">Todas las categorías</option>
      </select>
      <select id="stock-estado" class="admin-input" aria-label="Filtrar por estado">
        <option value="">Todos los estados</option>
        <option value="ok">OK</option>
        <option value="bajo">Stock bajo</option>
        <option value="sin">Sin stock</option>
      </select>
      <select id="stock-orden" class="admin-input" aria-label="Ordenar">
        <option value="nombre">Nombre A–Z</option>
        <option value="stock_asc">Menor stock</option>
        <option value="stock_desc">Mayor stock</option>
        <option value="precio_asc">Precio ↑</option>
        <option value="precio_desc">Precio ↓</option>
      </select>
    </div>
    <div class="admin-table-wrapper stock-scroll">
      <table class="admin-table">
        <thead>
          <tr><th>Producto</th><th>Categoría</th><th class="text-right">Precio</th><th class="text-right">Mín</th><th class="text-right">Stock</th><th>Estado</th></tr>
        </thead>
        <tbody id="stock-tabla">
          <tr><td colspan="6" class="text-center">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <h2 class="admin-card-title" style="margin-bottom: 1rem;">Últimos movimientos</h2>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th class="text-right">Cant.</th><th>Motivo</th></tr>
        </thead>
        <tbody id="mov-historial">
          <tr><td colspan="5" class="text-center">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    let productos: Array<any> = [];

    const sel = document.getElementById('mov-producto') as HTMLSelectElement;
    const stockInfo = document.getElementById('mov-stock-actual')!;
    const errDiv = document.getElementById('mov-error')!;
    const okDiv = document.getElementById('mov-ok')!;
    const btn = document.getElementById('mov-btn') as HTMLButtonElement;

    function actualizarStockInfo() {
      const p = productos.find((x) => x.producto_id === sel.value || x.id === sel.value);
      stockInfo.textContent = p ? `Stock actual: ${p.stock_actual ?? 0} u.` : '';
    }

    async function cargarProductos() {
      try {
        const res = await fetch('/api/admin/productos');
        if (!res.ok) return;
        productos = await res.json();
        sel.innerHTML = '<option value="">— Elegí un producto —</option>' + productos
          .map((p: any) => `<option value="${p.producto_id || p.id}">${p.nombre} · ${p.variante || 'Única'} (stock: ${p.stock_actual ?? 0})</option>`)
          .join('');
        const cats = [...new Set(productos.map((p: any) => p.categoria).filter(Boolean))].sort();
        const selCat = document.getElementById('stock-cat') as HTMLSelectElement;
        const actual = selCat.value;
        selCat.innerHTML = '<option value="">Todas las categorías</option>' +
          cats.map((c) => `<option value="${c}">${c}</option>`).join('');
        if (cats.includes(actual)) selCat.value = actual;
        renderResumen();
      } catch { /* noop */ }
    }

    async function cargarHistorial() {
      try {
        const res = await fetch('/api/admin/movimientos?limit=20');
        if (!res.ok) return;
        const movs: Array<any> = await res.json();
        const badge = (t: string) => {
          if (t === 'VENTA') return '<span class="mov-badge mov-sale">VENTA</span>';
          if (t === 'ENTRADA' || t === 'AJUSTE_POSITIVO') return '<span class="mov-badge mov-in">ENTRADA</span>';
          return '<span class="mov-badge mov-out">SALIDA</span>';
        };
        document.getElementById('mov-historial')!.innerHTML = movs.length
          ? movs.map((m) => {
              const signo = (m.tipo === 'VENTA' || m.tipo === 'AJUSTE_NEGATIVO') ? '−' : '+';
              const nombre = `${m.productos?.nombre || ''}${m.productos?.variante && m.productos.variante !== 'Única' ? ` · ${m.productos.variante}` : ''}`;
              const fecha = new Date(m.created_at).toLocaleString('es-AR');
              return `<tr><td>${fecha}</td><td>${nombre}</td><td>${badge(m.tipo)}</td><td class="text-right">${signo}${m.cantidad}</td><td>${m.motivo || '—'}</td></tr>`;
            }).join('')
          : '<tr><td colspan="5" class="text-center">Sin movimientos todavía.</td></tr>';
      } catch { /* noop */ }
    }

    function estadoDe(p: any): { key: string; texto: string; estilo: string } {
      const s = Number(p.stock_actual ?? 0);
      const min = Number(p.stock_minimo ?? 5);
      if (s <= 0) return { key: 'sin', texto: 'Sin stock', estilo: 'background: #fff5f5; color: #742a2a;' };
      if (s <= min) return { key: 'bajo', texto: 'Stock bajo', estilo: 'background: #fffbeb; color: #744210;' };
      return { key: 'ok', texto: 'OK', estilo: 'background: #f0fff4; color: #22543d;' };
    }

    function renderResumen() {
      const q = (document.getElementById('stock-q') as HTMLInputElement).value.trim().toLowerCase();
      const cat = (document.getElementById('stock-cat') as HTMLSelectElement).value;
      const est = (document.getElementById('stock-estado') as HTMLSelectElement).value;
      const orden = (document.getElementById('stock-orden') as HTMLSelectElement).value;

      const totalU = productos.reduce((s, p) => s + Number(p.stock_actual ?? 0), 0);
      const sinStock = productos.filter((p) => Number(p.stock_actual ?? 0) <= 0).length;
      const bajos = productos.filter((p) => {
        const s = Number(p.stock_actual ?? 0);
        return s > 0 && s <= Number(p.stock_minimo ?? 5);
      }).length;

      const chip = (t: string, estilo: string) =>
        `<span class="stock-badge" style="${estilo} font-size: 0.8125rem; padding: 0.375rem 0.75rem;">${t}</span>`;
      document.getElementById('stock-chips')!.innerHTML =
        chip(`${productos.length} productos`, '') +
        chip(`${totalU} u. en total`, '') +
        chip(`${bajos} bajos`, 'background: #fffbeb; color: #744210;') +
        chip(`${sinStock} sin stock`, sinStock ? 'background: #fff5f5; color: #742a2a;' : '');

      const filtrados = productos
        .filter((p: any) => {
          if (cat && (p.categoria || '') !== cat) return false;
          if (est && estadoDe(p).key !== est) return false;
          if (q && !`${p.nombre || ''} ${p.variante || ''} ${p.nombre_opcion || ''} ${p.sku || ''} ${p.categoria || ''}`.toLowerCase().includes(q)) return false;
          return true;
        });

      const grupos = new Map<string, Array<any>>();
      filtrados.forEach((p: any) => {
        const key = p.grupo_id || p.producto_id || p.id;
        const items = grupos.get(key) || [];
        items.push(p);
        grupos.set(key, items);
      });

      const gruposOrdenados = [...grupos.entries()].map(([grupo_id, items]) => ({
        grupo_id,
        items: items.sort((a: any, b: any) => String(a.variante || '').localeCompare(String(b.variante || ''), 'es')),
        nombre: String(items[0]?.nombre || ''),
        stock: items.reduce((s: number, p: any) => s + Number(p.stock_actual ?? 0), 0),
        precio: Math.min(...items.map((p: any) => Number(p.precio_venta ?? 0))),
      })).sort((a: any, b: any) => {
          switch (orden) {
            case 'stock_asc': return a.stock - b.stock;
            case 'stock_desc': return b.stock - a.stock;
            case 'precio_asc': return a.precio - b.precio;
            case 'precio_desc': return b.precio - a.precio;
            default: return a.nombre.localeCompare(b.nombre, 'es');
          }
        });

      document.getElementById('stock-tabla')!.innerHTML = gruposOrdenados.length
        ? gruposOrdenados.map((grupo: any) => {
          const cabecera = `<tr class="stock-group-row">
            <td colspan="4"><strong>${grupo.nombre}</strong><span>${grupo.items.length} ${grupo.items.length === 1 ? 'opción' : 'opciones'}</span></td>
            <td class="text-right"><strong>${grupo.stock} u.</strong></td><td></td>
          </tr>`;
          const opciones = grupo.items.map((p: any) => {
            const id = p.producto_id || p.id;
            const est = estadoDe(p);
            return `<tr data-prod="${id}" class="stock-option-row" title="Ver detalle">
              <td><span class="stock-option-kind">${p.nombre_opcion || 'Opción'}</span><span class="stock-option-badge">${p.variante || 'Única'}</span><br/><code>${p.sku || ''}</code></td>
              <td style="font-size: 0.875rem;">${p.categoria || '—'}</td>
              <td class="text-right">$${Number(p.precio_venta ?? 0).toLocaleString('es-AR')}</td>
              <td class="text-right">${p.stock_minimo ?? '—'}</td>
              <td class="text-right"><span class="stock-count stock-count-${est.key}">${p.stock_actual ?? 0}</span></td>
              <td><span class="stock-badge" style="${est.estilo}">${est.texto}</span></td>
            </tr>`;
          }).join('');
          return cabecera + opciones;
        }).join('')
        : '<tr><td colspan="6" class="text-center">Sin productos para este filtro.</td></tr>';
    }

    document.getElementById('stock-q')!.addEventListener('input', renderResumen);
    document.getElementById('stock-cat')!.addEventListener('change', renderResumen);
    document.getElementById('stock-estado')!.addEventListener('change', renderResumen);
    document.getElementById('stock-orden')!.addEventListener('change', renderResumen);
    document.getElementById('stock-tabla')!.addEventListener('click', (e) => {
      const tr = (e.target as HTMLElement).closest('[data-prod]') as HTMLElement | null;
      if (!tr || !tr.dataset.prod) return;
      abrirModal(tr.dataset.prod);
    });

    // ---- Modal de producto + ticket ----
    function fmtFecha(f: string): string {
      return new Date(f).toLocaleString('es-AR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    function signoTipo(t: string): string {
      return (t === 'VENTA' || t === 'AJUSTE_NEGATIVO') ? '−' : '+';
    }

    function nombreTipo(t: string): string {
      if (t === 'VENTA') return 'VENTA';
      if (t === 'ENTRADA' || t === 'AJUSTE_POSITIVO') return 'ENTRADA';
      return 'SALIDA';
    }

    async function abrirModal(id: string) {
      const p = productos.find((x: any) => (x.producto_id || x.id) === id);
      if (!p) return;
      cerrarModal();
      const est = estadoDe(p);
      const ahora = new Date().toLocaleString('es-AR');

      const root = document.createElement('div');
      root.id = 'prod-modal-root';
      root.innerHTML = `
      <div class="prod-modal-overlay">
        <div class="prod-modal-card prod-screen">
          <div class="pm-brand">
            <div>
              <p class="pm-logo">DOMUS</p>
              <p class="pm-sub">Control de stock · ${ahora}</p>
            </div>
            <button class="prod-modal-x" aria-label="Cerrar">×</button>
          </div>
          <div class="pm-hero">
            <div class="pm-hero-info">
              <h3>${p.nombre || ''}</h3>
              <span class="stock-option-badge">${p.variante || 'Única'}</span>
              <span class="stock-badge" style="${est.estilo}">${est.texto}</span>
            </div>
            <div class="pm-stock">
              <span class="pm-num">${p.stock_actual ?? 0}</span>
              <span class="pm-unit">unidades</span>
            </div>
          </div>
          <dl class="pm-grid">
            <div><dt>SKU</dt><dd>${p.sku || '—'}</dd></div>
            <div><dt>Categoría</dt><dd>${p.categoria || '—'}</dd></div>
            <div><dt>Precio</dt><dd>$${Number(p.precio_venta ?? 0).toLocaleString('es-AR')}</dd></div>
            <div><dt>Mínimo</dt><dd>${p.stock_minimo ?? '—'} u.</dd></div>
          </dl>
          <h4 class="pm-movs-title">Últimos movimientos</h4>
          <div id="pm-movs"><p class="pm-loading">Cargando…</p></div>
          <div class="prod-modal-actions no-print">
            <button class="admin-btn admin-btn-primary" id="ticket-print">Imprimir ticket</button>
            <button class="admin-btn admin-btn-ghost" id="ticket-ajustar">Ajustar stock</button>
            <button class="admin-btn admin-btn-ghost" id="ticket-cerrar">Cerrar</button>
          </div>
        </div>
        <div class="ticket" id="ticket">
          <p class="t-center t-logo">DOMUS</p>
          <p class="t-center">Control de stock</p>
          <p class="t-center">${ahora}</p>
          <p class="t-sep">--------------------------------</p>
          <p><strong>${p.nombre || ''} · ${p.variante || 'Única'}</strong></p>
          <p>SKU: ${p.sku || '—'}</p>
          <p>Categoría: ${p.categoria || '—'}</p>
          <p>Precio: $${Number(p.precio_venta ?? 0).toLocaleString('es-AR')}</p>
          <p class="t-big">STOCK: ${p.stock_actual ?? 0} u.</p>
          <p>Mínimo: ${p.stock_minimo ?? '—'} · Estado: ${est.texto.toUpperCase()}</p>
          <p class="t-sep">--------------------------------</p>
          <p>Últimos movimientos:</p>
          <div id="ticket-movs"><p>Cargando…</p></div>
          <p class="t-sep">--------------------------------</p>
          <p class="t-center">domus.com.ar</p>
        </div>
      </div>`;
      document.body.appendChild(root);
      document.body.style.overflow = 'hidden';

      const cerrar = () => cerrarModal();
      root.querySelector('.prod-modal-x')!.addEventListener('click', cerrar);
      root.querySelector('#ticket-cerrar')!.addEventListener('click', cerrar);
      root.querySelector('.prod-modal-overlay')!.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).classList.contains('prod-modal-overlay')) cerrar();
      });
      document.addEventListener('keydown', escCerrar);
      root.querySelector('#ticket-print')!.addEventListener('click', () => window.print());
      root.querySelector('#ticket-ajustar')!.addEventListener('click', () => {
        cerrar();
        sel.value = id;
        actualizarStockInfo();
        document.getElementById('mov-form')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      try {
        const res = await fetch(`/api/admin/movimientos?producto_id=${encodeURIComponent(id)}&limit=10`);
        const movs = res.ok ? await res.json() : [];
        const box = document.getElementById('ticket-movs');
        const pmBox = document.getElementById('pm-movs');
        const rows = movs.length
          ? movs.map((m: any) =>
              `<p>${fmtFecha(m.created_at)} · ${signoTipo(m.tipo)}${m.cantidad} ${nombreTipo(m.tipo)}${m.motivo ? ' · ' + m.motivo : ''}</p>`
            ).join('')
          : '<p>Sin movimientos.</p>';
        if (box) box.innerHTML = rows;
        if (pmBox) {
          pmBox.innerHTML = movs.length
            ? movs.map((m: any) => {
                const entra = !(m.tipo === 'VENTA' || m.tipo === 'AJUSTE_NEGATIVO');
                return `<div class="pm-mov">
                  <span class="pm-sign ${entra ? 'pm-in' : 'pm-out'}">${signoTipo(m.tipo)}${m.cantidad}</span>
                  <div class="pm-mov-info">
                    <strong>${nombreTipo(m.tipo)}</strong>
                    <small>${fmtFecha(m.created_at)}${m.motivo ? ' · ' + m.motivo : ''}</small>
                  </div>
                </div>`;
              }).join('')
            : '<p class="pm-loading">Sin movimientos.</p>';
        }
      } catch {
        const box = document.getElementById('ticket-movs');
        if (box) box.innerHTML = '<p>Sin movimientos.</p>';
        const pmBox = document.getElementById('pm-movs');
        if (pmBox) pmBox.innerHTML = '<p class="pm-loading">Sin movimientos.</p>';
      }
    }

    function escCerrar(e: KeyboardEvent) {
      if (e.key === 'Escape') cerrarModal();
    }

    function cerrarModal() {
      document.getElementById('prod-modal-root')?.remove();
      document.body.style.overflow = '';
      document.removeEventListener('keydown', escCerrar);
    }

    sel.addEventListener('change', actualizarStockInfo);

    document.getElementById('mov-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      errDiv.style.display = 'none';
      okDiv.style.display = 'none';
      btn.setAttribute('disabled', 'true');

      const tipo = (document.querySelector('input[name="mov-tipo"]:checked') as HTMLInputElement).value;
      const payload = {
        producto_id: sel.value,
        tipo,
        cantidad: Number((document.getElementById('mov-cantidad') as HTMLInputElement).value),
        motivo: (document.getElementById('mov-motivo') as HTMLInputElement).value.trim(),
      };

      try {
        const res = await fetch('/api/admin/movimientos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          errDiv.textContent = typeof data.error === 'string' ? data.error : JSON.stringify(data.error);
          errDiv.style.display = 'block';
          return;
        }
        okDiv.textContent = `Movimiento registrado: ${tipo === 'SALIDA' ? '−' : '+'}${payload.cantidad} u.`;
        okDiv.style.display = 'block';
        (document.getElementById('mov-motivo') as HTMLInputElement).value = '';
        await cargarProductos();
        actualizarStockInfo();
        await cargarHistorial();
      } catch {
        errDiv.textContent = 'Error de conexión';
        errDiv.style.display = 'block';
      } finally {
        btn.removeAttribute('disabled');
      }
    });

    cargarProductos();
    cargarHistorial();
  </script>

  <style is:global>
    .mov-badge { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.6875rem; font-weight: 700; }
    .mov-in { background: #f0fff4; color: #22543d; }
    .mov-out { background: #fff5f5; color: #742a2a; }
    .mov-sale { background: #ebf8ff; color: #2a4365; }
    .stock-group-row td { background: rgba(152, 140, 45, 0.11); border-top: 2px solid rgba(152, 140, 45, 0.28); padding-top: 0.75rem; padding-bottom: 0.75rem; }
    .stock-group-row span { margin-left: 0.65rem; color: var(--admin-text-muted); font-size: 0.75rem; font-weight: 400; }
    .stock-option-row { cursor: pointer; }
    .stock-option-row td:first-child { padding-left: 1.35rem; }
    .stock-option-kind { display: block; margin-bottom: 0.25rem; color: var(--admin-text-muted); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .stock-option-badge { display: inline-flex; margin: 0 0 0.3rem; padding: 0.22rem 0.6rem; border: 1px solid rgba(96,72,17,.25); border-radius: 999px; background: #fffdf8; color: #604811; font-size: 0.78rem; font-weight: 700; }
    .stock-count { display: inline-flex; min-width: 46px; justify-content: center; padding: 0.3rem 0.55rem; border-radius: 8px; font-size: 1.1rem; font-weight: 800; }
    .stock-count-ok { background: #f0fff4; color: #22543d; }
    .stock-count-bajo { background: #fffbeb; color: #744210; }
    .stock-count-sin { background: #fff5f5; color: #742a2a; }

    /* Modal de producto */
    #prod-modal-root { position: fixed; inset: 0; z-index: 2000; }
    .prod-modal-overlay {
      position: absolute; inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex; align-items: flex-start; justify-content: center;
      overflow-y: auto; padding: 2rem 1rem;
    }
    .prod-modal-card {
      background: #FDFBF5; border-radius: 14px;
      width: 100%; max-width: 560px;
      padding: 1.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      border-top: 4px solid #988C2D;
    }
    .pm-brand { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem; }
