---
// src/pages/admin/productos/index.astro
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import ProductList from '@/components/admin/ProductList.vue';
---

<AdminLayout title="Productos">
  <div class="admin-card-header">
    <h1 style="margin: 0; font-size: 1.5rem;">Productos</h1>
    <div class="prod-head-actions">
      <a href="/admin/productos/lista" class="admin-btn admin-btn-ghost">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        <span>Imprimir lista</span>
      </a>
      <a href="/admin/productos/nuevo" class="admin-btn admin-btn-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <span>Nuevo</span>
      </a>
    </div>
  </div>

  <div class="admin-card">
    <ProductList client:visible />
  </div>

<style>
  .prod-head-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .prod-head-actions .admin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 10px;
    padding: 0.375rem 0.875rem;
    min-height: 36px;
    font-size: 0.8125rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }

  .prod-head-actions .admin-btn:hover {
    filter: brightness(1.04);
  }

  .prod-head-actions .admin-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
</style>
</AdminLayout>
