---
import DomusLogo from './DomusLogo.astro';
---

<!-- 01 · ENTRADA -->
<section id="history" class="h-entry">
  <div class="container">
    <figure class="h-family reveal">
      <!-- Reemplazar este espacio por /images/familia.jpg cuando esté disponible. -->
      <div class="h-family-placeholder">
        <p>Fotografía familiar</p>
      </div>
    </figure>
    <div class="h-entry-copy">
      <p class="h-eyebrow reveal">Nuestra historia</p>
      <h2 class="h-entry-title reveal">DOMUS nació de nuestra manera de habitar.</h2>
      <p class="reveal"><strong>Somos cuatro.</strong></p>
      <p class="reveal">
        Una familia que, con los años, fue construyendo
        una forma propia de estar, compartir y disfrutar lo cotidiano.
      </p>
      <p class="reveal">DOMUS nace ahí.</p>
      <p class="reveal">
        En lo que elegimos para acompañarnos.<br />
        En los aromas.<br />
        En las texturas.<br />
        En una mesa compartida.<br />
        En la luz de un momento.<br />
        En esos pequeños gestos que hacen bien.
      </p>
      <p class="reveal">No fue una idea que apareció terminada.</p>
      <p class="reveal">
        <strong>La fuimos construyendo.<br />
        Y la seguimos construyendo.</strong>
      </p>
    </div>
  </div>
</section>

<!-- 03 · DOMUS / LATÍN -->
<section class="h-name">
  <div class="container">
    <p class="h-eyebrow reveal">Domus / latín</p>
    <h2 class="h-name-title reveal">
      Casa. Hogar.<br />
      Un espacio propio.
    </h2>
    <div class="h-name-copy">
      <p class="reveal">
        Elegimos <strong>DOMUS</strong> por lo que representa,
        pero también por todo lo que nos permite imaginar.
      </p>
      <p class="reveal">
        Porque habitar no es solamente ocupar un espacio.
      </p>
      <p class="reveal">
        Es elegir qué nos rodea.<br />
        Qué dejamos entrar.<br />
        Qué nos hace bien.<br />
        Qué compartimos.
      </p>
      <p class="reveal">Y también es mirar hacia adentro.</p>
    </div>
  </div>
</section>

<!-- 04 · HABITAR / HABITARSE -->
<section class="h-habitar">
  <div class="container">
    <h2 class="h-habitar-words reveal">
      Habitar<span class="h-dot">.</span><br />
      Habitarse<span class="h-dot">.</span>
    </h2>
  </div>
</section>

<!-- 05 · GALERÍA SENSORIAL -->
<section class="h-senses">
  <div class="container">
    <div class="h-senses-grid">
      <figure class="reveal">
        <!-- TODO: reemplazar por foto propia (cerámica) -->
        <img
          src="https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?q=80&w=800&auto=format&fit=crop"
          alt="Cerámica artesanal sobre madera"
          loading="lazy"
        />
      </figure>
      <figure class="reveal">
        <!-- TODO: reemplazar por foto propia (mesa compartida) -->
        <img
          src="https://images.unsplash.com/photo-1519710164239-da123dc03ef4?q=80&w=800&auto=format&fit=crop"
          alt="Mesa compartida con taza y luz natural"
          loading="lazy"
        />
      </figure>
      <figure class="reveal">
        <!-- TODO: reemplazar por foto propia (luz entrando por la ventana) -->
        <img
          src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?q=80&w=800&auto=format&fit=crop"
          alt="Luz natural entrando por la ventana"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<!-- 06 · AROMAS + SENTIDOS -->
<section class="h-aromas">
  <div class="container">
    <h2 class="h-aromas-title reveal">Empezamos por los aromas.</h2>
    <div class="h-aromas-copy">
      <p class="reveal">
        Porque un aroma puede cambiar la manera
        en que sentimos un espacio.
      </p>
      <p class="reveal">Pero DOMUS no termina ahí.</p>
      <p class="reveal">
        <strong>Queremos explorar distintas formas de habitar y habitarnos.</strong>
      </p>
    </div>
    <p class="h-senses-words reveal">
      oler&ensp;·&ensp;tocar&ensp;·&ensp;mirar&ensp;·&ensp;saborear&ensp;·&ensp;escuchar
    </p>
    <p class="h-senses-sub reveal">Los sentidos como una forma de volver a lo cotidiano.</p>
  </div>
</section>

<!-- 07 · CIERRE EN OLIVA -->
<section class="h-build">
  <div class="container">
    <h2 class="reveal">
      Una casa se construye.<br />
      Una forma de habitar, también.
    </h2>
    <p class="h-build-sub reveal"><strong>DOMUS también está en construcción.</strong></p>
    <p class="h-build-list reveal">
      Nuevos aromas.<br />
      Nuevas texturas.<br />
      Nuevas formas de sentir.
    </p>
  </div>
</section>

<!-- 08 · LOGO + CLAIM -->
<section class="h-closing">
  <div class="container">
    <div class="h-closing-logo reveal">
      <DomusLogo variant="sobre-claro" size="lg" />
    </div>
    <p class="h-closing-tag reveal">todo lo que hace de un lugar, hogar.</p>
  </div>
</section>

<style>
  .h-eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-oliva);
    margin-bottom: 2rem;
  }

  /* 01 · Entrada (marrón) */
  .h-entry {
    background: var(--color-tierra);
    padding: 8rem 0;
    scroll-margin-top: 5rem;
  }

  .h-entry .h-eyebrow,
  .h-name .h-eyebrow {
    color: var(--color-hueso);
  }

  .h-entry > .container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .h-entry-copy p + p,
  .h-name-copy p + p {
    margin-top: 1.75rem;
  }

  .h-entry-title {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1.2;
    color: var(--color-hueso);
    max-width: 24ch;
    margin-bottom: 3rem;
  }

  .h-entry-copy {
    max-width: 620px;
  }

  .h-entry-copy p:not(.h-eyebrow) {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-hueso);
  }

  .h-entry-copy strong {
    color: var(--color-hueso);
    font-weight: 500;
  }

  .h-family {
    margin: 0;
    width: 100%;
  }

  .h-family-placeholder {
    aspect-ratio: 4 / 5;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgba(219, 209, 144, 0.12);
    border: 1px solid rgba(219, 209, 144, 0.35);
    border-radius: 2px;
    text-align: center;
    padding: 2rem;
  }

  .h-family-placeholder p {
    font-family: var(--font-editorial);
    font-size: 1.25rem;
    color: var(--color-hueso);
    margin: 0;
  }

  .h-family img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    border-radius: 2px;
  }

  /* 03 · Latín (marrón) */
  .h-name {
    background: var(--color-tierra);
    padding: 0 0 8rem;
    text-align: center;
  }

  .h-name-title {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.25;
    color: var(--color-hueso);
    margin-bottom: 2.5rem;
  }

  .h-name-copy {
    max-width: 620px;
    margin: 0 auto;
  }

  .h-name-copy p {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-hueso);
  }

  .h-name-copy strong {
    color: var(--color-hueso);
    font-weight: 500;
  }

  /* 04 · Habitar / Habitarse (beige) */
  .h-habitar {
    background: var(--color-hueso);
    padding: 9rem 0;
    text-align: center;
  }

  .h-habitar-words {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(3rem, 11vw, 9rem);
    letter-spacing: -0.045em;
    line-height: 1.15;
    color: var(--color-tierra);
    margin: 0;
  }

  .h-dot {
    color: var(--color-oliva);
  }

  /* 05 · Galería (beige) */
  .h-senses {
    background: var(--color-hueso);
    padding: 0 0 7rem;
  }

  .h-senses-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .h-senses-grid figure {
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-hueso-light);
  }

  .h-senses-grid figure:nth-child(2) {
    margin-top: 4rem;
  }

  .h-senses-grid img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  /* 06 · Aromas + sentidos (beige) */
  .h-aromas {
    background: var(--color-hueso);
    padding: 0 0 7rem;
    text-align: center;
  }

  .h-aromas-title {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    color: var(--color-tierra);
    margin-bottom: 1.75rem;
  }

  .h-aromas-copy {
    max-width: 560px;
    margin: 0 auto 3rem;
  }

  .h-aromas-copy p {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    line-height: 1.8;
    color: rgba(96, 72, 17, 0.85);
  }

  .h-aromas-copy strong {
    color: var(--color-tierra);
    font-weight: 500;
  }

  .h-senses-words {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.5;
    color: var(--color-tierra);
    margin-bottom: 1rem;
  }

  .h-senses-sub {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-oliva-dark);
    margin: 0;
  }

  /* 07 · Cierre (oliva) */
  .h-build {
    background: var(--color-oliva);
    padding: 7rem 0;
    text-align: center;
  }

  .h-build h2 {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.25;
    color: var(--color-hueso);
    margin-bottom: 2.5rem;
  }

  .h-build-sub {
    font-family: var(--font-editorial);
    font-size: 1.25rem;
    color: var(--color-hueso);
    margin-bottom: 1.25rem;
  }

  .h-build-sub strong {
    font-weight: 500;
  }

  .h-build-list {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    line-height: 1.9;
    color: rgba(219, 209, 144, 0.9);
    margin: 0;
  }

  /* 08 · Logo + claim (beige) */
  .h-closing {
    background: var(--color-hueso);
    padding: 9rem 0;
    text-align: center;
  }

  .h-closing-logo {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .h-closing-tag {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    color: rgba(96, 72, 17, 0.75);
    margin: 0;
  }

  @media (max-width: 900px) {
    .h-entry > .container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .h-entry {
      padding: 5rem 0 4rem;
    }

    .h-name {
      padding-bottom: 5rem;
    }

    .h-habitar,
    .h-closing {
      padding: 5rem 0;
    }

    .h-senses-grid {
      grid-template-columns: 1fr;
      max-width: 380px;
    }

    .h-senses-grid figure:nth-child(2) {
      margin-top: 0;
    }

    .h-senses,
    .h-aromas,
    .h-build {
      padding-bottom: 5rem;
    }
  }
</style>
