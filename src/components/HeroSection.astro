---

---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow reveal">Aromas · Sentidos</p>

      <h1 class="hero-title reveal">
        Todo lo que hace<br />
        de un lugar, hogar.
      </h1>

      <p class="hero-text reveal">
        Una selección que empieza en los aromas.<br />
        Y sigue en lo cotidiano.
      </p>

      <div class="hero-ctas reveal">
        <a href="/#universo" class="btn">
          Descubrir Domus
          <span aria-hidden="true">→</span>
        </a>
        <a href="/#history" class="link-underline">
          Conocé nuestra historia
        </a>
      </div>
    </div>

    <figure class="hero-media reveal">
      <!-- TODO: reemplazar por /images/hero-domus.jpg (foto editorial final: vela + sahumerio + lino) -->
      <img
        src="https://images.unsplash.com/photo-1602874801007-bd458bb1b8b6?q=80&w=1200&auto=format&fit=crop"
        alt="Vela encendida y sahumerio sobre cerámica junto a lino crudo, con luz cálida lateral"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-hueso);
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: calc(4.5rem + var(--space-lg)) 0 var(--space-xl);
  }

  .hero-grid {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 5rem;
    align-items: center;
  }

  .hero-eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-oliva-dark);
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(2.75rem, 5.2vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-tierra);
    margin-bottom: 1.75rem;
  }

  .hero-text {
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(96, 72, 17, 0.85);
    max-width: 42ch;
    margin-bottom: 2.75rem;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    flex-wrap: wrap;
  }

  .hero-media {
    margin: 0;
    width: 100%;
    max-width: 520px;
    margin-left: auto;
    aspect-ratio: 4 / 5;
    max-height: 560px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-hueso-light);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: calc(4rem + var(--space-md));
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 0 1.25rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }

    .hero-media {
      max-width: 100%;
      margin-left: 0;
      aspect-ratio: 4 / 3;
      max-height: 420px;
    }

    .hero-ctas {
      gap: 1.5rem;
    }
  }
</style>
