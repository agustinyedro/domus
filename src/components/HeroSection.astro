---
---

<section class="hero">
  <div class="hero-bg"></div>
  
  <div class="hero-content">
    <div class="logo-container reveal">
      <svg viewBox="0 0 200 100" class="logo-roof">
        <polyline 
          points="50,50 100,20 150,50" 
          stroke="currentColor" 
          stroke-width="2" 
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="logo-text">DOMUS</span>
    </div>
    
    <h1 class="reveal">Sentí tu hogar en cada detalle</h1>
    
    <p class="subtitle reveal">
      Aromas, momentos y sensaciones diseñadas para que cada espacio se sienta verdaderamente tuyo.
    </p>
    
    <p class="description reveal">
      Porque el hogar no es un lugar. Es una sensación.
    </p>
    
    <div class="cta-buttons reveal">
      <button class="btn" onclick="document.getElementById('packs').scrollIntoView({behavior: 'smooth'})">
        Descubre nuestros packs
      </button>
      <button class="btn btn-secondary" onclick="document.getElementById('history').scrollIntoView({behavior: 'smooth'})">
        Nuestra historia
      </button>
    </div>
  </div>
  
  <div class="scroll-indicator">
    <span>Scroll</span>
    <div class="scroll-arrow"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    background: linear-gradient(135deg, 
      var(--color-brown) 0%, 
      var(--color-brown-light) 50%, 
      var(--color-olive) 100%);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 20% 30%, rgba(152, 140, 45, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(232, 147, 79, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(155, 89, 182, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .logo-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-lg);
  }

  .logo-roof {
    width: 120px;
    height: 60px;
    color: var(--color-olive-light);
    animation: float 4s ease-in-out infinite;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-beige-light);
    margin-top: var(--space-sm);
  }

  .hero h1 {
    color: var(--color-beige-light);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .subtitle {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    color: var(--color-beige);
    margin-bottom: var(--space-sm);
    font-family: var(--font-accent);
    font-style: italic;
  }

  .description {
    font-size: 1.125rem;
    color: rgba(245, 240, 232, 0.8);
    margin-bottom: var(--space-lg);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    min-width: 200px;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-beige);
    opacity: 0.7;
    animation: fadeIn 2s ease-out 1.5s both;
  }

  .scroll-indicator span {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .scroll-arrow {
    width: 24px;
    height: 24px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-lg) var(--space-sm);
    }

    .logo-roof {
      width: 80px;
      height: 40px;
    }

    .cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>