---
import { getWhatsAppLink } from '../config';
---
<section id="packs" class="gifts domus-editorial" aria-labelledby="gifts-title">
  <div class="container gifts-layout">
    <div class="reveal">
      <p class="eyebrow">Regalar DOMUS</p>
      <h2 id="gifts-title" class="editorial-title">Hay cosas que se regalan.<br />Y otras que se hacen sentir.</h2>
    </div>
    <div class="gifts-copy reveal" id="gifts-copy">
      <span class="gift-mark" aria-hidden="true">Para vos.<br />Para alguien.</span>
      <p class="eyebrow">Próximamente</p>
      <p>Estamos preparando nuevas formas de regalar DOMUS.</p>
      <a href={getWhatsAppLink('Hola, quiero enterarme de las nuevas formas de regalar DOMUS.')} target="_blank" rel="noopener noreferrer" class="editorial-link">Quiero enterarme <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="container">
    <div id="gifts-kits" class="gifts-kits" hidden></div>
  </div>
</section>

<script>
  const IMG_FALLBACK = 'https://images.unsplash.com/photo-1602928321679-560bb453f190?w=600&h=600&fit=crop';
  const fmt = (n: number) => `$${Math.round(n).toLocaleString('es-AR')}`;

  async function cargarKitsIndex() {
    try {
      const res = await fetch('/api/tienda/kits', { cache: 'no-store' });
      if (!res.ok) return;
      const kits: Array<any> = await res.json();
      if (!kits.length) return;

      const box = document.getElementById('gifts-kits')!;
      const copy = document.getElementById('gifts-copy');
      if (copy) copy.hidden = true;

      box.innerHTML = `
        <p class="gifts-kits-title">Kits para regalar</p>
        <div class="gifts-kits-grid">
          ${kits.map((k) => {
            const img = k.imagen_url || IMG_FALLBACK;
            const sinStock = (k.stock_actual ?? 0) <= 0;
            return `<a class="gift-card" href="/tienda?sector=Kits">
              <div class="gift-card-media"><img src="${img}" alt="${(k.nombre || '').replace(/</g, '&lt;')}" loading="lazy" /></div>
              <div class="gift-card-body">
                <h3>${(k.nombre || '').replace(/</g, '&lt;')}</h3>
                ${k.descripcion ? `<p>${(k.descripcion || '').replace(/</g, '&lt;')}</p>` : ''}
                <div class="gift-card-foot">
                  <span class="gift-card-price">${fmt(Number(k.precio_final ?? k.precio_venta))}</span>
                  <span class="gift-card-cta">${sinStock ? 'Sin stock' : 'Ver kit ↗'}</span>
                </div>
              </div>
            </a>`;
          }).join('')}
        </div>`;
      box.hidden = false;
    } catch { /* sin kits: queda el bloque Próximamente */ }
  }

  cargarKitsIndex();
</script>

<style>
  .gifts { background: var(--color-tierra); color: var(--color-hueso); }
  .gifts-layout { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(3rem, 8vw, 8rem); align-items: end; }
  .gifts .editorial-title { margin-bottom: 0; }
  .gifts-copy p:not(.eyebrow) { max-width: 28ch; }
  .gift-mark { display: block; font-family: var(--font-editorial); font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.25; margin-bottom: 4rem; }
  @media (max-width: 750px) {
    .gifts-layout { grid-template-columns: 1fr; }
    .gift-mark { margin-bottom: 2.5rem; }
  }
</style>

<style is:global>
  .gifts-kits { margin-top: 4rem; }
  .gifts-kits-title { font: 400 0.75rem var(--font-heading); text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-oliva); margin-bottom: 1.5rem; }
  .gifts-kits-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.25rem; }
  .gift-card { display: flex; flex-direction: column; background: var(--color-hueso-soft); border-radius: 12px; overflow: hidden; text-decoration: none; color: var(--color-tierra); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .gift-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25); }
  .gift-card-media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--color-hueso-light); }
  .gift-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gift-card-body { padding: 0.875rem 1rem 1.125rem; display: flex; flex-direction: column; gap: 0.375rem; flex: 1; }
  .gift-card-body h3 { font-family: var(--font-editorial); font-weight: 400; font-size: 1.125rem; margin: 0; }
  .gift-card-body p { font-size: 0.875rem; line-height: 1.5; color: rgba(96, 72, 17, 0.7); margin: 0; }
  .gift-card-foot { margin-top: auto; display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; padding-top: 0.75rem; }
  .gift-card-price { font-family: var(--font-heading); font-weight: 700; font-size: 1.125rem; }
  .gift-card-cta { font: 400 0.75rem var(--font-heading); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-oliva-dark); }
</style>
