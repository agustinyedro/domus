<section id="universo" class="manifesto">
  <div class="container">
    <p class="manifesto-lines reveal">
      Un aroma que recibe.<br />
      Una luz que acompaña.<br />
      Una textura que abriga.
    </p>

    <p class="manifesto-sub reveal">
      Creemos que son las pequeñas cosas las que transforman un espacio.
    </p>

    <nav class="manifesto-universe reveal" aria-label="Universo DOMUS">
      <a href="/aromas">Aromas</a>
      <span aria-hidden="true">—</span>
      <a href="/tienda">Objetos</a>
      <span aria-hidden="true">—</span>
      <a href="/tienda">Textiles</a>
      <span aria-hidden="true">—</span>
      <a href="/comida">Sabores</a>
    </nav>
  </div>
</section>

<style>
  .manifesto {
    background: var(--color-hueso-soft);
    padding: 7rem 0;
    text-align: center;
  }

  .manifesto-lines {
    font-family: 'Bricolage Grotesque', serif;
    font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.35;
    color: var(--color-tierra);
    margin-bottom: 2rem;
  }

  .manifesto-sub {
    font-family: 'Bricolage Grotesque', serif;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(96, 72, 17, 0.75);
    max-width: 52ch;
    margin: 0 auto 3.5rem;
  }

  .manifesto-universe {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-oliva-dark);
  }

  .manifesto-universe a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .manifesto-universe a:hover {
    color: var(--color-tierra);
  }

  .manifesto-universe span {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .manifesto {
      padding: 4.5rem 0;
    }
  }
</style>
