---
import { config, getWhatsAppLink } from '../config';
const consultations = getWhatsAppLink('Hola, quiero hacer una consulta sobre DOMUS.');
const collaborations = getWhatsAppLink('Hola, me gustaría conversar sobre una colaboración con DOMUS.');
---
<section id="contact" class="contact-section domus-editorial" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow reveal">Contacto</p>
    <div class="contact-layout">
      <div class="contact-copy reveal">
        <h2 id="contact-title" class="editorial-title">Hablemos.</h2>
        <p class="contact-intro">Si querés preguntarnos algo, conocer más sobre un producto, trabajar con DOMUS o simplemente escribirnos, estamos del otro lado.</p>
        <div class="contact-path">
          <h3>Ventas &amp; consultas</h3>
          <a class="editorial-link" href={consultations} target="_blank" rel="noopener noreferrer">Escribinos por WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-path">
          <h3>Colaboraciones</h3>
          <p>Para marcas, artistas, espacios y proyectos que quieran crear algo con DOMUS.</p>
          <a class="editorial-link" href={collaborations} target="_blank" rel="noopener noreferrer">Conversemos <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <form id="whatsapp-form" class="contact-form reveal" action={`https://wa.me/${config.whatsapp.phoneNumber}`} method="get">
        <div class="form-group">
          <label for="contact-name">Nombre</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" minlength="2" maxlength="100" required />
        </div>
        <div class="form-group">
          <label for="contact-email">Email <span>(opcional)</span></label>
          <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="tu@email.com" maxlength="254" />
        </div>
        <div class="form-group">
          <label for="contact-interest">¿De qué hablamos?</label>
          <select id="contact-interest" name="interest">
            <option value="Consulta general">Consulta general</option>
            <option value="Aromas">Aromas</option>
            <option value="Regalar DOMUS">Regalar DOMUS</option>
            <option value="Colaboraciones">Colaboraciones</option>
          </select>
        </div>
        <div class="form-group">
          <label for="contact-message">Mensaje</label>
          <textarea id="contact-message" name="text" placeholder="Contanos…" rows="4" maxlength="2000" required></textarea>
        </div>
        <button type="submit" class="editorial-link">Continuar en WhatsApp <span aria-hidden="true">→</span></button>
        <p class="editorial-note">Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
      </form>
    </div>
  </div>
  <a class="whatsapp-float" href={consultations} target="_blank" rel="noopener noreferrer" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M21 11.5a9 9 0 0 1-13.2 8L3 21l1.5-4.8A9 9 0 1 1 21 11.5Z" />
      <path d="M8 7.5c0 4.5 4 8.5 8.5 8.5l1-2.5-3-1-1 1c-1.5-.5-2.5-1.5-3-3l1-1-1-3Z" />
    </svg>
  </a>
</section>
<style>
  .contact-layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 8vw, 8rem); }
  .contact-intro { max-width: 40ch; line-height: 1.8; }
  .contact-path { margin-top: 3rem; }
  .contact-path h3 { font: 400 0.75rem var(--font-heading); text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem; }
  .contact-path p { max-width: 37ch; font-size: 1rem; }
  .contact-form { min-width: 0; padding-top: 0.75rem; }
  .form-group { margin-bottom: 2rem; }
  .form-group label { display: block; font-size: 0.875rem; margin-bottom: 0.5rem; }
  .form-group label span { font-size: 0.75rem; }
  .form-group input, .form-group select, .form-group textarea { display: block; width: 100%; border: 0; border-bottom: 1px solid rgba(96, 72, 17, 0.5); border-radius: 0; padding: 0.8rem 0; background: transparent; color: var(--color-tierra); font: 1rem var(--font-body); }
  .form-group input::placeholder, .form-group textarea::placeholder { color: var(--color-tierra); opacity: 0.7; }
  .form-group select option { background: var(--color-hueso); }
  .form-group textarea { resize: vertical; }
  .form-group :is(input, select, textarea):focus-visible { outline: 2px solid var(--color-tierra); outline-offset: 4px; }
  .contact-form button { border: 0; border-bottom: 1px solid currentColor; width: 100%; }
  .contact-form .editorial-note { margin-top: 1rem; }
  .whatsapp-float { position: fixed; right: 1.25rem; bottom: 1.25rem; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--color-tierra); color: var(--color-hueso); border: 1px solid var(--color-hueso); z-index: 90; }
  .whatsapp-float svg { width: 26px; height: 26px; }
  @media (max-width: 750px) {
    .contact-layout { grid-template-columns: 1fr; }
  }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#whatsapp-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const message = String(data.get('text') || '').trim();
    const nameInput = form.querySelector<HTMLInputElement>('#contact-name')!;
    const messageInput = form.querySelector<HTMLTextAreaElement>('#contact-message')!;
    nameInput.setCustomValidity(name.length < 2 ? 'Escribí tu nombre.' : '');
    messageInput.setCustomValidity(!message ? 'Contanos en qué podemos ayudarte.' : '');
    if (!form.reportValidity()) return;
    const email = String(data.get('email') || '').trim();
    const text = [
      `Hola, soy ${name}.`,
      `Quería conversar sobre: ${data.get('interest')}.`,
      message,
      ...(email ? [`Mi email: ${email}`] : []),
    ].join('\n\n');
    const destination = new URL(form.action);
    destination.searchParams.set('text', text);
    window.location.assign(destination.href);
  });
  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((field) => {
    field.addEventListener('input', () => field.setCustomValidity(''));
  });
</script>
