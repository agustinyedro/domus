---
import DomusLogo from './DomusLogo.astro';

const navLinks = [
  { href: '/tienda', label: 'Tienda' },
  { href: '/#universo', label: 'Universos' },
  { href: '/#history', label: 'Nuestra historia' },
  { href: '/#contact', label: 'Contacto' }
];
---

<nav class="navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-logo" aria-label="DOMUS - Inicio">
      <DomusLogo variant="sobre-beige" size="sm" />
    </a>

    <div class="navbar-links">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <div class="navbar-actions">
      <a href="/tienda" class="icon-btn" aria-label="Buscar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.5" y2="16.5"/>
        </svg>
      </a>
      <button class="icon-btn cart-btn" onclick="CartManager.toggleCart()" aria-label="Carrito">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="cart-count" style="display: none;">0</span>
      </button>

      <button class="hamburger" aria-label="Menú">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu">
  <div class="mobile-menu-content">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav-link">{link.label}</a>
    ))}
  </div>
</div>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1.25rem 0;
    background: rgba(219, 209, 144, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(96, 72, 17, 0.22);
    transition: all 0.3s ease-out;
  }

  .navbar.scrolled {
    padding: 0.75rem 0;
    background: rgba(219, 209, 144, 0.92);
    box-shadow: 0 2px 20px rgba(96, 72, 17, 0.16);
  }

  .navbar-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .navbar-logo {
    text-decoration: none;
    display: inline-flex;
    padding: 0.5rem 0;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    margin-left: auto;
  }

  .nav-link {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-tierra);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: var(--color-oliva-dark);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 1rem;
  }

  .icon-btn {
    position: relative;
    background: none;
    border: none;
    color: var(--color-tierra);
    cursor: pointer;
    padding: 0.5rem;
    display: inline-flex;
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .icon-btn:hover {
    color: var(--color-oliva-dark);
  }

  .icon-btn svg {
    width: 22px;
    height: 22px;
  }

  .cart-count {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--color-oliva);
    color: var(--color-hueso);
    font-size: 0.7rem;
    font-weight: 500;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger span {
    width: 24px;
    height: 2px;
    background: var(--color-tierra);
    transition: all 0.3s ease;
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-hueso);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .mobile-nav-link {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tierra);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .mobile-nav-link:hover {
    color: var(--color-oliva-dark);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .navbar-links {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .navbar-container {
      padding: 0 1.25rem;
    }
  }
</style>
