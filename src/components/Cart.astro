---
---

<!-- Cart Overlay -->
<div class="cart-overlay" onclick="CartManager.toggleCart()" aria-hidden="true"></div>

<!-- Cart Sidebar -->
<aside class="cart-sidebar" role="dialog" aria-modal="true" aria-label="Mi carrito">
  <div class="cart-header">
    <h3>Mi Carrito</h3>
    <button class="cart-close" onclick="CartManager.toggleCart()" aria-label="Cerrar carrito">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  
  <div class="cart-items">
    <div class="cart-empty">
      <p>Tu carrito está vacío</p>
      <a href="/tienda" class="btn cart-empty-cta">Explorar la tienda</a>
    </div>
  </div>

  <div class="cart-footer">
    <div class="cart-total">
      <span>Total <span class="cart-count-label"></span></span>
      <span class="cart-total-amount">$0</span>
    </div>
    <a class="btn cart-checkout-btn" id="checkout-btn" href="/carrito" hidden>
      Finalizar compra
    </a>
    <button class="cart-clear" id="clear-cart-btn" style="display: none;" onclick="CartManager.clearCart()">
      Vaciar carrito
    </button>
    <a class="cart-full-link" href="/carrito">Ver carrito completo →</a>
    <p class="cart-note">Te contactaremos por WhatsApp para confirmar tu pedido.</p>
    <button class="cart-alt" id="consultar-btn">o consultanos por WhatsApp</button>
  </div>
</aside>

<style is:global>
  /* Global a propósito: los items/botones se inyectan por JS
     y los estilos scopados de Astro no les aplicarían. */
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  
  .cart-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  
  .cart-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 400px;
    background: white;
    z-index: 1200;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  
  .cart-sidebar.open {
    transform: translateX(0);
  }
  
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(61, 43, 31, 0.1);
  }
  
  .cart-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-brown);
  }
  
  .cart-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-brown);
    transition: color 0.3s ease;
  }
  
  .cart-close:hover {
    color: var(--color-olive);
  }
  
  .cart-close svg {
    width: 24px;
    height: 24px;
  }
  
  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }
  
  .cart-empty {
    text-align: center;
    color: var(--color-brown-light);
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .cart-empty p {
    margin: 0;
  }

  .cart-empty-cta {
    font-size: 0.9375rem;
  }

  .cart-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(61, 43, 31, 0.08);
  }

  .cart-item:last-child {
    border-bottom: none;
  }

  .cart-thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    background: var(--color-beige);
  }

  .cart-thumb-ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--color-olive);
    font-size: 1.25rem;
  }

  .cart-item-info {
    flex: 1;
    min-width: 0;
  }

  .cart-item-info h4 {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-brown);
    line-height: 1.3;
  }

  .cart-item-price {
    margin: 0 0 0.5rem;
    color: var(--color-brown-light);
    font-size: 0.8125rem;
  }

  .cart-item-subtotal {
    margin: 0;
    font-weight: 700;
    color: var(--color-olive);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .cart-item-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Steppers circulares propios del carrito */
  .quantity-btn {
    width: 44px;
    height: 44px;
    border: 1.5px solid rgba(61, 43, 31, 0.18);
    background: var(--color-beige-light);
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-brown);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    touch-action: manipulation;
  }

  .quantity-btn:hover:not(:disabled) {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: white;
    transform: scale(1.06);
  }

  .quantity-btn:active:not(:disabled) {
    transform: scale(0.94);
  }

  .quantity-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .cart-quantity {
    min-width: 28px;
    text-align: center;
    font-weight: 700;
    color: var(--color-brown);
  }

  /* Tacho rojo con pastilla al hover */
  .remove-btn {
    margin-left: auto;
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--color-peligro);
    cursor: pointer;
    padding: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .remove-btn:hover {
    background: var(--color-peligro-suave);
  }

  .remove-btn:active {
    transform: scale(0.9);
  }

  .quantity-btn:focus-visible,
  .remove-btn:focus-visible,
  .cart-clear:focus-visible,
  .cart-checkout-btn:focus-visible,
  .cart-empty-cta:focus-visible {
    outline: 2px solid var(--color-olive);
    outline-offset: 2px;
  }
  
  .cart-footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(61, 43, 31, 0.1);
    background: var(--color-beige-light);
  }
  
  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }
  
  .cart-total-amount {
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-olive);
  }
  
  /* Botón principal del carrito: oliva con profundidad */
  .cart-checkout-btn {
    width: 100%;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: linear-gradient(135deg, var(--color-olive) 0%, #7a701f 100%);
    box-shadow: 0 6px 16px rgba(152, 140, 45, 0.35);
  }

  .cart-checkout-btn:hover {
    box-shadow: 0 8px 22px rgba(152, 140, 45, 0.45);
    filter: brightness(1.05);
  }

  .cart-checkout-btn:active {
    transform: translateY(1px) scale(0.99);
    box-shadow: 0 3px 10px rgba(152, 140, 45, 0.3);
  }

  .cart-checkout-btn[hidden] {
    display: none;
  }

  .cart-count-label {
    font-size: 0.8125rem;
    color: var(--color-brown-light);
    font-weight: 400;
  }

  /* Vaciar: pastilla outline que avisa en rojo al hover */
  .cart-clear {
    width: 100%;
    background: transparent;
    border: 1.5px dashed rgba(61, 43, 31, 0.25);
    border-radius: 12px;
    color: var(--color-brown-light);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.625rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .cart-clear:hover {
    color: var(--color-peligro);
    border-color: var(--color-peligro);
    background: var(--color-peligro-suave);
    border-style: solid;
  }

  /* CTA del estado vacío */
  .cart-empty-cta {
    border-radius: 999px;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    background: transparent;
    color: var(--color-olive);
    border: 2px solid var(--color-olive);
    box-shadow: none;
  }

  .cart-empty-cta:hover {
    background: var(--color-olive);
    color: white;
    box-shadow: 0 6px 16px rgba(152, 140, 45, 0.35);
  }
  
  .cart-note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-brown-light);
    margin: 0;
  }
  
  /* Notificación */
  .cart-notification {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--color-brown);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    z-index: 2000;
    opacity: 0;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: min(92vw, 560px);
    box-shadow: 0 10px 30px rgba(61, 43, 31, 0.35);
  }
  
  .cart-notification.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  .cart-notification-text {
    line-height: 1.35;
  }

  .cart-notification-action {
    flex-shrink: 0;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.55rem 1rem;
    min-height: 44px;
    border-radius: 999px;
    border: 1.5px solid var(--color-olive);
    background: var(--color-olive);
    color: white;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cart-notification-action:hover {
    background: white;
    color: var(--color-olive);
    transform: translateY(-1px);
  }

  .cart-notification-action:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }
  
  @media (max-width: 480px) {
    .cart-sidebar {
      max-width: 100%;
    }
  }

  /* Alternativa WhatsApp */
  .cart-alt {
    width: 100%;
    background: none;
    border: none;
    color: var(--color-brown-light);
    font-family: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    padding: 0.25rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cart-alt:hover {
    color: var(--color-olive);
  }

  /* Link al carrito completo (checkout vive en /carrito) */
  .cart-full-link {
    display: block;
    text-align: center;
    min-height: 44px;
    line-height: 44px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-olive);
    text-decoration: none;
    border-radius: 12px;
    margin-bottom: 0.5rem;
  }

  .cart-full-link:hover {
    background: rgba(152, 140, 45, 0.08);
  }

  .cart-full-link:focus-visible {
    outline: 2px solid var(--color-olive);
    outline-offset: 2px;
  }
</style>

<script>
  import { abrirUrl, leerCarrito, mensajeWhatsAppConsultar, urlWhatsApp } from '../js/checkout';

  function cerrarCarrito() {
    const cartSidebar = document.querySelector('.cart-sidebar');
    const cartOverlay = document.querySelector('.cart-overlay');
    if (cartSidebar) cartSidebar.classList.remove('open');
    if (cartOverlay) cartOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Alternativa: solo consultar por WhatsApp (sin crear pedido)
  document.getElementById('consultar-btn')?.addEventListener('click', () => {
    const cart = leerCarrito();
    if (!cart.length) return;
    abrirUrl(urlWhatsApp(mensajeWhatsAppConsultar(cart)));
    cerrarCarrito();
  });
</script>