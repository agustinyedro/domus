---
---

<!-- Cart Overlay -->
<div class="cart-overlay" onclick="CartManager.toggleCart()"></div>

<!-- Cart Sidebar -->
<aside class="cart-sidebar">
  <div class="cart-header">
    <h3>Mi Carrito</h3>
    <button class="cart-close" onclick="CartManager.toggleCart()" aria-label="Cerrar carrito">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  
  <div class="cart-items">
    <div class="cart-empty">
      <p>Tu carrito está vacío</p>
      <a href="/tienda" class="btn cart-empty-cta">Explorar la tienda</a>
    </div>
  </div>

  <div class="cart-footer">
    <div class="cart-total">
      <span>Total <span class="cart-count-label"></span></span>
      <span class="cart-total-amount">$0</span>
    </div>
    <button class="btn cart-checkout-btn" id="checkout-btn" disabled>
      Finalizar compra
    </button>
    <button class="cart-clear" id="clear-cart-btn" style="display: none;" onclick="CartManager.clearCart()">
      Vaciar carrito
    </button>
    <p class="cart-note">Te contactaremos por WhatsApp para confirmar tu pedido.</p>
    <button class="cart-alt" id="consultar-btn">o consultanos por WhatsApp</button>
  </div>

  <!-- Paso 2: datos + método de pago -->
  <div class="checkout-panel" id="checkout-panel" hidden>
    <button class="checkout-back" id="checkout-back" aria-label="Volver al carrito">← Volver</button>
    <h3>Finalizar compra</h3>
    <p class="checkout-total">Total: <strong id="checkout-total">$0</strong></p>

    <label class="checkout-label" for="co-nombre">Tu nombre</label>
    <input id="co-nombre" type="text" class="checkout-input" autocomplete="name" placeholder="Ej: María" maxlength="255" />

    <label class="checkout-label" for="co-tel">Teléfono / WhatsApp</label>
    <input id="co-tel" type="tel" class="checkout-input" autocomplete="tel" placeholder="Ej: 11 1234 5678" maxlength="50" />

    <p class="checkout-label">Método de pago</p>
    <label class="checkout-radio">
      <input type="radio" name="co-metodo" value="EFECTIVO" checked />
      <span><strong>Efectivo</strong><small>Coordinamos por WhatsApp, te lo reservamos con nuestro OK</small></span>
    </label>
    <label class="checkout-radio">
      <input type="radio" name="co-metodo" value="MP" />
      <span><strong>Mercado Pago</strong><small>Tarjeta, débito o dinero en cuenta</small></span>
    </label>

    <div id="checkout-error" class="cart-error" hidden></div>

    <button class="btn cart-checkout-btn" id="confirmar-btn">Confirmar pedido</button>
  </div>
</aside>

<style is:global>
  /* Global a propósito: los items/botones se inyectan por JS
     y los estilos scopados de Astro no les aplicarían. */
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  
  .cart-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  
  .cart-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 400px;
    background: white;
    z-index: 1200;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  
  .cart-sidebar.open {
    transform: translateX(0);
  }
  
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(61, 43, 31, 0.1);
  }
  
  .cart-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-brown);
  }
  
  .cart-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-brown);
    transition: color 0.3s ease;
  }
  
  .cart-close:hover {
    color: var(--color-olive);
  }
  
  .cart-close svg {
    width: 24px;
    height: 24px;
  }
  
  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }
  
  .cart-empty {
    text-align: center;
    color: var(--color-brown-light);
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .cart-empty p {
    margin: 0;
  }

  .cart-empty-cta {
    font-size: 0.9375rem;
  }

  .cart-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(61, 43, 31, 0.08);
  }

  .cart-item:last-child {
    border-bottom: none;
  }

  .cart-thumb {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    background: var(--color-beige);
  }

  .cart-thumb-ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--color-olive);
    font-size: 1.25rem;
  }

  .cart-item-info {
    flex: 1;
    min-width: 0;
  }

  .cart-item-info h4 {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-brown);
    line-height: 1.3;
  }

  .cart-item-price {
    margin: 0 0 0.5rem;
    color: var(--color-brown-light);
    font-size: 0.8125rem;
  }

  .cart-item-subtotal {
    margin: 0;
    font-weight: 700;
    color: var(--color-olive);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .cart-item-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Steppers circulares propios del carrito */
  .quantity-btn {
    width: 38px;
    height: 38px;
    border: 1.5px solid rgba(61, 43, 31, 0.18);
    background: var(--color-beige-light);
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-brown);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    touch-action: manipulation;
  }

  .quantity-btn:hover:not(:disabled) {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: white;
    transform: scale(1.06);
  }

  .quantity-btn:active:not(:disabled) {
    transform: scale(0.94);
  }

  .quantity-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .cart-quantity {
    min-width: 28px;
    text-align: center;
    font-weight: 700;
    color: var(--color-brown);
  }

  /* Tacho rojo con pastilla al hover */
  .remove-btn {
    margin-left: auto;
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #dc3545;
    cursor: pointer;
    padding: 0.45rem;
    display: inline-flex;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .remove-btn:hover {
    background: #fde8e8;
  }

  .remove-btn:active {
    transform: scale(0.9);
  }

  .quantity-btn:focus-visible,
  .remove-btn:focus-visible,
  .cart-clear:focus-visible,
  .cart-checkout-btn:focus-visible,
  .cart-empty-cta:focus-visible {
    outline: 2px solid var(--color-olive);
    outline-offset: 2px;
  }
  
  .cart-footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(61, 43, 31, 0.1);
    background: var(--color-beige-light);
  }
  
  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }
  
  .cart-total-amount {
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-olive);
  }
  
  /* Botón principal del carrito: oliva con profundidad */
  .cart-checkout-btn {
    width: 100%;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: linear-gradient(135deg, var(--color-olive) 0%, #7a701f 100%);
    box-shadow: 0 6px 16px rgba(152, 140, 45, 0.35);
  }

  .cart-checkout-btn:hover:not(:disabled) {
    box-shadow: 0 8px 22px rgba(152, 140, 45, 0.45);
    filter: brightness(1.05);
  }

  .cart-checkout-btn:active:not(:disabled) {
    transform: translateY(1px) scale(0.99);
    box-shadow: 0 3px 10px rgba(152, 140, 45, 0.3);
  }

  .cart-checkout-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .cart-count-label {
    font-size: 0.8125rem;
    color: var(--color-brown-light);
    font-weight: 400;
  }

  /* Vaciar: pastilla outline que avisa en rojo al hover */
  .cart-clear {
    width: 100%;
    background: transparent;
    border: 1.5px dashed rgba(61, 43, 31, 0.25);
    border-radius: 12px;
    color: var(--color-brown-light);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.625rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .cart-clear:hover {
    color: #dc3545;
    border-color: #dc3545;
    background: #fff5f5;
    border-style: solid;
  }

  /* CTA del estado vacío */
  .cart-empty-cta {
    border-radius: 999px;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    background: transparent;
    color: var(--color-olive);
    border: 2px solid var(--color-olive);
    box-shadow: none;
  }

  .cart-empty-cta:hover {
    background: var(--color-olive);
    color: white;
    box-shadow: 0 6px 16px rgba(152, 140, 45, 0.35);
  }
  
  .cart-note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-brown-light);
    margin: 0;
  }
  
  /* Notificación */
  .cart-notification {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--color-brown);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    z-index: 2000;
    opacity: 0;
    transition: all 0.3s ease;
  }
  
  .cart-notification.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
  
  @media (max-width: 480px) {
    .cart-sidebar {
      max-width: 100%;
    }
  }

  /* Alternativa WhatsApp */
  .cart-alt {
    width: 100%;
    background: none;
    border: none;
    color: var(--color-brown-light);
    font-family: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    padding: 0.25rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cart-alt:hover {
    color: var(--color-olive);
  }

  /* Panel checkout paso 2 */
  .checkout-panel {
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .checkout-panel[hidden] {
    display: none;
  }

  .checkout-back {
    align-self: flex-start;
    background: none;
    border: none;
    color: var(--color-brown-light);
    font-family: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    padding: 0.25rem 0;
  }

  .checkout-back:hover {
    color: var(--color-olive);
  }

  .checkout-panel h3 {
    margin: 0;
    color: var(--color-brown);
    font-size: 1.25rem;
  }

  .checkout-total {
    margin: 0;
    color: var(--color-brown);
  }

  .checkout-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brown);
    margin: 0.25rem 0 0;
  }

  .checkout-input {
    width: 100%;
    padding: 0.75rem;
    border: 1.5px solid rgba(61, 43, 31, 0.2);
    border-radius: 10px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-brown);
    background: white;
  }

  .checkout-input:focus {
    outline: 2px solid var(--color-olive);
    outline-offset: 1px;
    border-color: var(--color-olive);
  }

  .checkout-radio {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.875rem;
    border: 1.5px solid rgba(61, 43, 31, 0.15);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .checkout-radio:has(input:checked) {
    border-color: var(--color-olive);
    background: rgba(152, 140, 45, 0.06);
  }

  .checkout-radio input {
    accent-color: var(--color-olive);
    width: 18px;
    height: 18px;
    margin-top: 0.125rem;
  }

  .checkout-radio span {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .checkout-radio small {
    color: var(--color-brown-light);
    font-size: 0.8125rem;
  }

  .cart-error {
    background: #fff5f5;
    border: 1px solid #fed7d7;
    color: #742a2a;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
  }

  .cart-error[hidden] {
    display: none;
  }
</style>

<script>
  import { config } from '../config';

  interface CartItem {
    id: string;
    name: string;
    price: number;
    quantity: number;
    image?: string;
  }

  function leerCarrito(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('domus_cart') || '[]');
    } catch {
      return [];
    }
  }

  function cerrarCarrito() {
    const cartSidebar = document.querySelector('.cart-sidebar');
    const cartOverlay = document.querySelector('.cart-overlay');
    if (cartSidebar) cartSidebar.classList.remove('open');
    if (cartOverlay) cartOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  function abrirUrl(url: string) {
    const w = window.open(url, '_blank');
    if (!w) window.location.href = url;
  }

  const itemsBox = document.querySelector('.cart-items')!;
  const footerBox = document.querySelector('.cart-footer') as HTMLElement;
  const panel = document.getElementById('checkout-panel')!;
  const checkoutBtn = document.getElementById('checkout-btn');
  const backBtn = document.getElementById('checkout-back');
  const confirmarBtn = document.getElementById('confirmar-btn') as HTMLButtonElement;
  const errorBox = document.getElementById('checkout-error')!;

  // Paso 1 -> Paso 2 (datos y pago)
  checkoutBtn?.addEventListener('click', () => {
    const cart = leerCarrito();
    if (!cart.length) return;
    const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
    document.getElementById('checkout-total')!.textContent = `$${total.toLocaleString('es-AR')}`;
    errorBox.hidden = true;
    itemsBox.setAttribute('hidden', '');
    footerBox.style.display = 'none';
    panel.hidden = false;
  });

  backBtn?.addEventListener('click', () => {
    panel.hidden = true;
    itemsBox.removeAttribute('hidden');
    footerBox.style.display = '';
  });

  // Alternativa: solo consultar por WhatsApp (sin crear pedido)
  document.getElementById('consultar-btn')?.addEventListener('click', () => {
    const cart = leerCarrito();
    if (!cart.length) return;

    let message = 'Hola! Me gustaría consultar por estos productos:\n\n';
    cart.forEach((item) => {
      message += `- ${item.name} (x${item.quantity}) - $${item.price * item.quantity}\n`;
    });
    const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
    message += `\nTotal estimado: $${total}\n\n¿Están disponibles?`;

    abrirUrl(`https://wa.me/${config.whatsapp.phoneNumber}?text=${encodeURIComponent(message)}`);
    cerrarCarrito();
  });

  // Confirmar pedido: crea venta + redirige según método
  confirmarBtn?.addEventListener('click', async () => {
    const nombre = (document.getElementById('co-nombre') as HTMLInputElement).value.trim();
    const telefono = (document.getElementById('co-tel') as HTMLInputElement).value.trim();
    const metodo = (document.querySelector('input[name="co-metodo"]:checked') as HTMLInputElement)?.value as 'MP' | 'EFECTIVO';

    errorBox.hidden = true;
    if (nombre.length < 2 || telefono.length < 6) {
      errorBox.textContent = 'Contanos tu nombre y un teléfono válido para coordinar.';
      errorBox.hidden = false;
      return;
    }

    const cart = leerCarrito();
    if (!cart.length) return;

    confirmarBtn.setAttribute('disabled', 'true');
    confirmarBtn.textContent = 'Procesando…';

    try {
      const res = await fetch('/api/checkout/crear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map((i) => ({ producto_id: i.id, cantidad: i.quantity })),
          cliente: { nombre, telefono },
          metodo,
        }),
      });
      const data = await res.json();

      if (!res.ok) {
        errorBox.textContent = typeof data.error === 'string' ? data.error : 'No se pudo crear el pedido.';
        errorBox.hidden = false;
        return;
      }

      if (metodo === 'EFECTIVO' && data.whatsapp_url) {
        localStorage.setItem('domus_cart', '[]');
        window.dispatchEvent(new Event('domus:cart-cleared'));
        CartManager.updateCartCount();
        CartManager.updateCartDisplay();
        cerrarCarrito();
        abrirUrl(data.whatsapp_url as string);
        return;
      }

      if (metodo === 'MP' && data.init_point) {
        localStorage.setItem('domus_cart', '[]');
        window.location.href = data.init_point as string;
        return;
      }

      errorBox.textContent = 'Respuesta inesperada del servidor.';
      errorBox.hidden = false;
    } catch {
      errorBox.textContent = 'Error de conexión. Probá de nuevo.';
      errorBox.hidden = false;
    } finally {
      confirmarBtn.removeAttribute('disabled');
      confirmarBtn.textContent = 'Confirmar pedido';
    }
  });
</script>