---
import '../styles/globals.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'DOMUS - Sentir tu hogar en cada detalle',
  description = 'Aromas, momentos y sensaciones diseñadas para que cada espacio se sienta verdaderamente tuyo. Descubrí nuestra historia y nuestros packs de suscripción.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#988C2D">
  
  <!-- Preload Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  
  <title>{title}</title>
</head>
<body>
  <slot />
  
  <script>
    import '../js/animations.js';
  </script>
</body>
</html>