        max-width: none;
        padding: 0.5rem 0.75rem;
        background: var(--admin-card-bg);
        border-bottom: 1px solid var(--admin-border);
        box-shadow: 0 10px 24px rgb(0 0 0 / 0.1);
        z-index: 70;
      }

      .admin-search.is-open {
        display: block;
      }

      .admin-main {
        padding: 1rem 0.75rem 1.5rem;
      }

      .admin-main-full {
        min-height: 100dvh;
