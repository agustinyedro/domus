---
// src/layouts/AdminLayout.astro
// Layout para el panel de administración

interface Props {
  title: string;
}

const { title } = Astro.props;

// Si el usuario no está logueado y esta página no es login, redirigir
const isLoginPage = Astro.url.pathname === '/admin/login';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navClass = (path: string) => ({
  'sidebar-link': true,
  'is-active': path === '/admin' ? currentPath === path : currentPath.startsWith(path),
});
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | DOMUS Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
  {!isLoginPage && (
    <header class="admin-mobile-header">
      <button id="admin-menu-btn" class="admin-menu-btn" type="button" aria-label="Abrir menú" aria-controls="admin-sidebar" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <a href="/admin" class="admin-mobile-logo">DOMUS <small>Admin</small></a>
      <a href="/" class="admin-mobile-site">Ver sitio</a>
    </header>
  )}

  {!isLoginPage && <button id="admin-sidebar-overlay" class="admin-sidebar-overlay" type="button" aria-label="Cerrar menú"></button>}

  {!isLoginPage && (
    <aside id="admin-sidebar" class="admin-sidebar" aria-label="Navegación administrativa">
      <div class="sidebar-header">
        <a href="/admin" class="sidebar-logo">DOMUS</a>
        <span class="sidebar-subtitle">Admin</span>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin" class:list={navClass('/admin')}>Dashboard</a>
        <a href="/admin/pedidos" class:list={navClass('/admin/pedidos')}>Pedidos</a>
        <a href="/admin/productos" class:list={navClass('/admin/productos')}>Productos</a>
        <a href="/admin/stock" class:list={navClass('/admin/stock')}>Stock</a>
        <a href="/admin/gastos" class:list={navClass('/admin/gastos')}>Gastos</a>
        <a href="/admin/compras" class:list={navClass('/admin/compras')}>Compras</a>
        <a href="/admin/ventas" class:list={navClass('/admin/ventas')}>Ventas</a>
        <a href="/admin/kits" class:list={navClass('/admin/kits')}>Kits</a>
        <a href="/admin/club" class:list={navClass('/admin/club')}>Club</a>
      </nav>
      <div class="sidebar-footer">
        <a href="/" class="sidebar-link">Ver sitio</a>
        <button id="logout-btn" class="sidebar-link sidebar-logout">Cerrar sesión</button>
      </div>
    </aside>
  )}

  <main class={isLoginPage ? 'admin-main admin-main-full' : 'admin-main'}>
    <slot />
  </main>

  {!isLoginPage && (
    <div id="admin-toast" class="admin-toast" role="status" aria-live="polite"></div>
  )}

  <style is:global>
    :root {
      --admin-bg: #f8f9fa;
      --admin-sidebar-bg: #1a1a2e;
      --admin-sidebar-text: #e0e0e0;
      --admin-sidebar-active: #988C2D;
      --admin-card-bg: #ffffff;
      --admin-border: #e2e8f0;
      --admin-text: #1a202c;
      --admin-text-muted: #718096;
      --admin-primary: #988C2D;
      --admin-primary-hover: #8a7e28;
      --admin-success: #48bb78;
      --admin-danger: #f56565;
      --admin-warning: #ed8936;
      --admin-info: #4299e1;
      --admin-toast-bg: #604811;
    }

    .admin-body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--admin-bg);
      color: var(--admin-text);
      margin: 0;
      min-height: 100vh;
      display: flex;
    }

    /* Sidebar */
    .admin-sidebar {
      width: 240px;
      box-sizing: border-box;
      overflow-x: hidden;
      background: var(--admin-sidebar-bg);
      color: var(--admin-sidebar-text);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 50;
    }

    .admin-mobile-header,
    .admin-sidebar-overlay {
      display: none;
    }

    .sidebar-header {
      padding: 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .sidebar-logo {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--admin-sidebar-active);
      text-decoration: none;
      letter-spacing: 0.15em;
    }

    .sidebar-subtitle {
      display: block;
      font-size: 0.75rem;
      color: var(--admin-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 0.25rem;
    }

    .sidebar-nav {
      flex: 1;
      padding: 1rem 0;
      display: flex;
      flex-direction: column;
    }

    .sidebar-link {
      display: block;
      box-sizing: border-box;
      padding: 0.75rem 1.5rem;
      color: var(--admin-sidebar-text);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      border: none;
      background: none;
      width: 100%;
      max-width: 100%;
      text-align: left;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }

    .sidebar-link:hover {
      background: rgba(255,255,255,0.05);
      color: var(--admin-sidebar-active);
    }

    .sidebar-footer {
      padding: 1rem 0;
      border-top: 1px solid rgba(255,255,255,0.1);
    }

    .sidebar-logout {
      color: var(--admin-danger);
    }

    /* Main */
    .admin-main {
      margin-left: 240px;
      padding: 2rem;
      flex: 1;
      min-height: 100vh;
    }

    .admin-main-full {
      margin-left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Cards */
    .admin-card {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 8px;
      padding: 1.5rem;
    }

    .admin-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .admin-card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin: 0;
    }

    /* Metrics */
    .admin-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .admin-metric {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 8px;
      padding: 1.25rem;
    }

    .admin-metric-label {
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--admin-text-muted);
      margin: 0 0 0.5rem;
    }

    .admin-metric-value {
      font-size: 1.75rem;
      font-weight: 700;
      margin: 0;
    }

    .admin-metric-value.success { color: var(--admin-success); }
    .admin-metric-value.danger { color: var(--admin-danger); }
    .admin-metric-value.warning { color: var(--admin-warning); }
    .admin-metric-value.info { color: var(--admin-info); }

    /* Forms */
    .admin-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 480px;
    }

    .admin-form-group {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .admin-form-label {
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--admin-text);
    }

    .admin-input {
      padding: 0.625rem 0.75rem;
      border: 1px solid var(--admin-border);
      border-radius: 6px;
      font-size: 0.875rem;
      font-family: inherit;
      background: var(--admin-card-bg);
      color: var(--admin-text);
      transition: border-color 0.2s;
    }

    .sidebar-link.is-active {
      background: rgba(152, 140, 45, 0.18);
      color: var(--admin-sidebar-active);
      box-shadow: inset 3px 0 0 var(--admin-sidebar-active);
    }

    select.admin-input {
      min-height: 44px;
    }

    .admin-input:focus {
      outline: none;
      border-color: var(--admin-primary);
      box-shadow: 0 0 0 3px rgba(152, 140, 45, 0.15);
    }

    .admin-input.warning {
      background: #fffbeb;
      border-color: var(--admin-warning);
    }

    /* Buttons */
    .admin-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      border: none;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      min-height: 44px;
    }

    .admin-btn:active {
      transform: scale(0.98);
    }

    .admin-btn:focus-visible,
    .sidebar-link:focus-visible,
    .admin-menu-btn:focus-visible,
    .admin-mobile-site:focus-visible {
      outline: 3px solid var(--admin-sidebar-active);
      outline-offset: 2px;
    }

    .admin-btn-primary {
      background: var(--admin-primary);
      color: white;
    }

    .admin-btn-primary:hover {
      background: var(--admin-primary-hover);
    }

    .admin-btn-success {
      background: var(--admin-success);
      color: white;
    }

    .admin-btn-danger {
      background: var(--admin-danger);
      color: white;
    }

    .admin-btn-ghost {
      background: transparent;
      color: var(--admin-text);
      border: 1px solid var(--admin-border);
    }

    .admin-btn-ghost:hover {
      background: var(--admin-bg);
    }

    /* Tacho para quitar filas (compras, ventas, kits) */
    .row-del {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      background: none;
      border: 1px solid transparent;
      border-radius: 6px;
      color: #e53e3e;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
      flex-shrink: 0;
    }

    .row-del:hover {
      background: #fff5f5;
      border-color: #fed7d7;
    }

    .admin-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Table */
    .admin-table-wrapper {
      overflow-x: auto;
      max-width: 100%;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
    }

    .admin-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    .admin-table th {
      text-align: left;
      padding: 0.75rem;
      border-bottom: 2px solid var(--admin-border);
      font-weight: 600;
      color: var(--admin-text-muted);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .admin-table td {
      padding: 0.75rem;
      border-bottom: 1px solid var(--admin-border);
    }

    .admin-table tr:hover td {
      background: rgba(152, 140, 45, 0.03);
    }

    .admin-table .text-right {
      text-align: right;
    }

    .admin-table .text-center {
      text-align: center;
    }

    /* Alerts */
    .admin-alert {
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }

    .admin-alert-success {
      background: #f0fff4;
      color: #22543d;
      border: 1px solid #c6f6d5;
    }

    .admin-alert-error {
      background: #fff5f5;
      color: #742a2a;
      border: 1px solid #fed7d7;
    }

    .admin-alert-warning {
      background: #fffbeb;
      color: #744210;
      border: 1px solid #fefcbf;
    }

    /* Toast global: feedback tras guardar (arriba al centro) */
    .admin-toast {
      position: fixed;
      top: 1.25rem;
      left: 50%;
      transform: translate(-50%, -0.75rem);
      z-index: 4000;
      max-width: min(92vw, 30rem);
      padding: 0.875rem 1.25rem;
      border-radius: 8px;
      background: var(--admin-toast-bg);
      color: #ffffff;
      box-shadow: 0 10px 30px rgb(0 0 0 / 0.3);
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1.4;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .admin-toast.is-visible {
      opacity: 1;
      transform: translate(-50%, 0);
      pointer-events: auto;
    }

    @media (prefers-reduced-motion: reduce) {
      .admin-toast {
        transition: none;
        transform: translate(-50%, 0);
      }
    }

    /* Empty state */
    .admin-empty {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--admin-text-muted);
    }

    /* Stock badge */
    .stock-badge {
      display: inline-block;
      padding: 0.125rem 0.5rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .stock-ok {
      background: #f0fff4;
      color: #22543d;
    }

    .stock-low {
      background: #fff5f5;
      color: #742a2a;
    }

    /* Login */
    .login-card {
      background: var(--admin-card-bg);
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 2.5rem;
      width: 100%;
      max-width: 400px;
    }

    .login-title {
      font-size: 1.5rem;
      font-weight: 700;
      text-align: center;
      margin: 0 0 0.5rem;
    }

    .login-subtitle {
      text-align: center;
      color: var(--admin-text-muted);
      font-size: 0.875rem;
      margin: 0 0 1.5rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .admin-body {
        display: block;
        overflow-x: hidden;
      }

      .admin-mobile-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 90;
        display: grid;
        grid-template-columns: 44px 1fr auto;
        align-items: center;
        gap: 0.75rem;
        min-height: 60px;
        padding: 0.5rem 0.75rem;
        background: var(--admin-sidebar-bg);
        box-shadow: 0 3px 14px rgb(0 0 0 / 0.18);
      }

      .admin-menu-btn {
        display: grid;
        place-content: center;
        gap: 4px;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 1px solid rgb(255 255 255 / 0.18);
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
      }

      .admin-menu-btn span {
        display: block;
        width: 20px;
        height: 2px;
        border-radius: 2px;
        background: var(--admin-sidebar-text);
      }

      .admin-mobile-logo {
        color: var(--admin-sidebar-active);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-decoration: none;
      }

      .admin-mobile-logo small {
        display: block;
        color: var(--admin-sidebar-text);
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.06em;
      }

      .admin-mobile-site {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--admin-sidebar-text);
        font-size: 0.75rem;
        text-decoration: none;
      }

      .admin-sidebar {
        width: min(82vw, 300px);
        height: 100dvh;
        position: fixed;
        flex-direction: column;
        overflow-y: auto;
        transform: translateX(-105%);
        transition: transform 0.25s ease;
        z-index: 110;
        box-shadow: 10px 0 30px rgb(0 0 0 / 0.25);
      }

      .admin-sidebar.is-open {
        transform: translateX(0);
      }

      .admin-sidebar-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        width: 100%;
        height: 100%;
        border: 0;
        background: rgb(0 0 0 / 0.48);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }

      .admin-sidebar-overlay.is-open {
        display: block;
        opacity: 1;
        pointer-events: auto;
      }

      .sidebar-header {
        display: block;
        padding: 1.25rem;
      }

      .sidebar-footer {
        display: block;
      }

      .sidebar-nav {
        flex-direction: column;
        padding: 0.5rem 0;
      }

      .sidebar-link {
        display: flex;
        align-items: center;
        min-height: 48px;
        padding: 0.75rem 1.25rem;
        white-space: normal;
      }

      .admin-main {
        margin-left: 0;
        width: 100%;
        max-width: 100vw;
        padding: 5rem 0.75rem 1.5rem;
        box-sizing: border-box;
      }

      .admin-main-full {
        min-height: 100dvh;
        padding: 1rem;
      }

      .admin-toast {
        top: 4.5rem;
      }

      .admin-card {
        min-width: 0;
        padding: 1rem;
        border-radius: 10px;
      }

      .admin-card-header {
        align-items: stretch;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      .admin-card-header > div {
        width: 100%;
        flex-wrap: wrap;
      }

      .admin-form {
        width: 100%;
        max-width: none;
      }

      .admin-input {
        width: 100%;
        min-height: 44px;
        box-sizing: border-box;
        font-size: 1rem;
      }

      textarea.admin-input {
        min-height: 96px;
      }

      .admin-btn {
        min-height: 44px;
      }

      .admin-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      .admin-metric {
        min-width: 0;
        padding: 1rem;
      }

      .admin-metric-value {
        font-size: 1.4rem;
        overflow-wrap: anywhere;
      }

      .admin-table-wrapper {
        width: 100%;
        margin-inline: 0;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
      }

      .admin-table {
        min-width: 660px;
      }

      .admin-table th,
      .admin-table td {
        padding: 0.65rem;
      }

      .admin-main [style*="grid-template-columns"] {
        grid-template-columns: minmax(0, 1fr) !important;
      }

      .login-card {
        max-width: calc(100vw - 1.5rem);
        padding: 1.5rem;
        box-sizing: border-box;
      }
    }

    @media (max-width: 420px) {
      .admin-metrics {
        grid-template-columns: 1fr;
      }

      .admin-mobile-site {
        font-size: 0.7rem;
      }
    }

    /* Impresión: solo el contenido, sin sidebar ni botones */
    @media print {
      .admin-sidebar,
      .no-print {
        display: none !important;
      }

      .admin-main {
        margin-left: 0;
        padding: 0;
      }

      .admin-body {
        background: white;
      }
    }
  </style>

  {!isLoginPage && (
    <script>
      const menu = document.getElementById('admin-sidebar');
      const menuBtn = document.getElementById('admin-menu-btn');
      const menuOverlay = document.getElementById('admin-sidebar-overlay');
      const setMenu = (open: boolean) => {
        menu?.classList.toggle('is-open', open);
        menuOverlay?.classList.toggle('is-open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        menuBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        document.body.style.overflow = open ? 'hidden' : '';
      };
      menuBtn?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
      menuOverlay?.addEventListener('click', () => setMenu(false));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false);
      });

      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });

      const toast = document.getElementById('admin-toast');
      if (toast) {
        let timer = 0;
        const ocultar = () => {
          toast.classList.remove('is-visible');
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            toast.textContent = '';
          }, 300);
        };
        const mostrar = (mensaje: string) => {
          if (!mensaje) return;
          toast.textContent = mensaje;
          window.clearTimeout(timer);
          toast.classList.add('is-visible');
          timer = window.setTimeout(ocultar, 4000);
        };
        toast.addEventListener('click', ocultar);
        (window as Window & { adminToast?: (mensaje: string) => void }).adminToast = mostrar;
        try {
          const flash = sessionStorage.getItem('domus:admin-flash');
          if (flash) {
            sessionStorage.removeItem('domus:admin-flash');
            mostrar(flash);
          }
        } catch { /* sin sessionStorage */ }
      }
    </script>
  )}
</body>
</html>
