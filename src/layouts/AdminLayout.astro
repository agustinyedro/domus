      }

      .login-card {
        max-width: calc(100vw - 1.5rem);
        padding: 1.5rem;
        box-sizing: border-box;
      }
    }

    @media (max-width: 420px) {
      .admin-metrics {
        grid-template-columns: 1fr;
      }
    }

    /* Impresión: solo el contenido, sin sidebar ni botones */
    @media print {
      .admin-sidebar,
      .admin-topbar,
      .no-print {
        display: none !important;
      }

      .admin-shell {
        margin-left: 0;
      }

      .admin-main {
        padding: 0;
      }

      .admin-body {
        background: white;
      }
    }
  </style>

  {!isLoginPage && (
    <script>
      const menu = document.getElementById('admin-sidebar');
      const menuBtn = document.getElementById('admin-menu-btn');
      const menuOverlay = document.getElementById('admin-sidebar-overlay');
      const setMenu = (open: boolean) => {
        menu?.classList.toggle('is-open', open);
        menuOverlay?.classList.toggle('is-open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        menuBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        document.body.style.overflow = open ? 'hidden' : '';
      };
      menuBtn?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
      menuOverlay?.addEventListener('click', () => setMenu(false));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenu(false);
      });

      document.querySelectorAll('.sidebar-group-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const group = btn.closest('.sidebar-group');
          const open = group?.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(Boolean(open)));
        });
      });

      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });

      // Buscador global (productos + órdenes)
      const searchInput = document.getElementById('admin-search-input') as HTMLInputElement | null;
      const searchResults = document.getElementById('admin-search-results');
      const searchBox = document.getElementById('admin-search');
      if (searchInput && searchResults && searchBox) {
        type Destino = { href: string };
        let destinos: Destino[] = [];
        let activo = -1;
        let debounce = 0;

        const esc = (s: unknown) =>
          String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        const fmt$ = (n: unknown) => '$' + Math.round(Number(n) || 0).toLocaleString('es-AR');

        const cerrar = () => {
          searchResults.hidden = true;
          searchInput.setAttribute('aria-expanded', 'false');
          activo = -1;
        };

        const marcarActivo = () => {
          searchResults.querySelectorAll('.admin-search-item').forEach((el) => {
            el.classList.toggle('is-active', Number((el as HTMLElement).dataset.idx) === activo);
          });
        };

        const pintar = (data: { productos?: Array<Record<string, unknown>>; ordenes?: Array<Record<string, unknown>> }) => {
          destinos = [];
          const partes: string[] = [];
          const productos = data.productos || [];
          const ordenes = data.ordenes || [];

          if (productos.length) {
            partes.push('<p class="admin-search-group">Productos</p>');
            for (const p of productos) {
              const idx = destinos.length;
              destinos.push({ href: `/admin/productos/${p.producto_id}` });
              const variante = p.variante && p.variante !== 'Única' ? ` — ${esc(p.variante)}` : '';
              partes.push(
                `<button type="button" class="admin-search-item" data-idx="${idx}" role="option"><span>${esc(p.nombre)}${variante}</span><small>${esc(p.sku || '')} · stock ${esc(p.stock_actual ?? 0)}</small></button>`,
              );
            }
          }

          if (ordenes.length) {
            partes.push('<p class="admin-search-group">Órdenes</p>');
            for (const o of ordenes) {
              const idx = destinos.length;
              const id = String(o.id);
              destinos.push({ href: `/admin/ventas?q=${id.slice(0, 8)}` });
              const origen = o.source === 'TIENDA' ? 'Tienda' : 'POS';
              const cliente = o.cliente_nombre ? ` · ${esc(o.cliente_nombre)}` : '';
              partes.push(
                `<button type="button" class="admin-search-item" data-idx="${idx}" role="option"><span>#${id.slice(0, 8)} · ${origen}${cliente}</span><small>${fmt$(o.total)} · ${esc(o.estado)}</small></button>`,
              );
            }
          }

          searchResults.innerHTML = partes.join('') || '<p class="admin-search-empty">Sin resultados.</p>';
          searchResults.hidden = false;
          searchInput.setAttribute('aria-expanded', 'true');
          activo = -1;
        };

        const buscar = async () => {
          const q = searchInput.value.trim();
          if (q.length < 2) {
            cerrar();
            return;
          }
          try {
            const res = await fetch(`/api/admin/buscar?q=${encodeURIComponent(q)}`, { cache: 'no-store' });
            if (!res.ok) {
              cerrar();
              return;
            }
            pintar(await res.json());
          } catch {
            cerrar();
          }
        };

        searchInput.addEventListener('input', () => {
          window.clearTimeout(debounce);
          debounce = window.setTimeout(buscar, 220);
        });

        searchInput.addEventListener('keydown', (e) => {
          if (searchResults.hidden) return;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            activo = Math.min(activo + 1, destinos.length - 1);
            marcarActivo();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            activo = Math.max(activo - 1, 0);
            marcarActivo();
          } else if (e.key === 'Enter') {
            const destino = destinos[activo] || destinos[0];
            if (destino) {
              e.preventDefault();
              window.location.href = destino.href;
            }
          } else if (e.key === 'Escape') {
            cerrar();
          }
        });

        searchResults.addEventListener('click', (e) => {
          const item = (e.target as HTMLElement).closest('.admin-search-item') as HTMLElement | null;
          const destino = item ? destinos[Number(item.dataset.idx)] : null;
          if (destino) window.location.href = destino.href;
        });

        document.addEventListener('click', (e) => {
          if (!searchBox.contains(e.target as Node)) cerrar();
        });
      }

      // Toggle de búsqueda en mobile (la topbar queda en una sola fila)
      const searchToggle = document.getElementById('admin-search-toggle');
      const searchBoxEl = document.getElementById('admin-search');
      if (searchToggle && searchBoxEl) {
        searchToggle.addEventListener('click', () => {
          const open = searchBoxEl.classList.toggle('is-open');
          searchToggle.setAttribute('aria-expanded', String(open));
          if (open) (document.getElementById('admin-search-input') as HTMLInputElement | null)?.focus();
        });
      }

      const toast = document.getElementById('admin-toast');
      if (toast) {
        let timer = 0;
        const ocultar = () => {
          toast.classList.remove('is-visible');
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            toast.textContent = '';
          }, 300);
        };
        const mostrar = (mensaje: string) => {
          if (!mensaje) return;
          toast.textContent = mensaje;
          window.clearTimeout(timer);
          toast.classList.add('is-visible');
          timer = window.setTimeout(ocultar, 4000);
        };
        toast.addEventListener('click', ocultar);
        (window as Window & { adminToast?: (mensaje: string) => void }).adminToast = mostrar;
        try {
          const flash = sessionStorage.getItem('domus:admin-flash');
          if (flash) {
            sessionStorage.removeItem('domus:admin-flash');
            mostrar(flash);
          }
        } catch { /* sin sessionStorage */ }
      }
    </script>
