      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .admin-form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.25rem;
    }

    .admin-form-grid .span-2 {
