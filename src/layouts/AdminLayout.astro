    .admin-section-title {
      margin: 0 0 1rem;
      font-size: 0.875rem;
      font-weight: 600;
    }

    @media (max-width: 640px) {
      .admin-form-grid {
        grid-template-columns: 1fr;
      }

      .admin-section {
        padding: 1rem;
      }
