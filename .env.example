# DOMUS - Variables de entorno
# Copiar a .env y completar con tus valores de Supabase

# Supabase (Cliente - expuestos al browser)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase (Servidor - NO exponer al browser)
# Solo necesaria para operaciones admin que requieren service_role
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Keep-alive diario (cron-job.org -> /api/cron/keep-alive?key=...)
# Generar aleatorio de 32+ caracteres. Cargarlo también en Cloudflare Pages.
# CRON_SECRET=tu_secreto_aleatorio

# Mercado Pago (solo servidor, activar cuando tengan credenciales)
# MP_ACCESS_TOKEN=tu_access_token
# MP_PUBLIC_KEY=tu_public_key
# MP_WEBHOOK_SECRET=tu_webhook_secret
# URL pública del sitio (para volver de MP y notificaciones)
# SITE_URL=https://tu-dominio.com
